{
  "info": {
    "name": "Spark Blogs API",
    "description": "Blog endpoints of the spark_blogs module. Demo users password: {{demo_password}}. Run a request from \"0. Auth\" first to fill {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8070"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "demo_password",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Auth (login first)",
      "description": "Run one login request first. It saves the access token in the collection variable {{token}} automatically. The token lives 15 minutes.",
      "item": [
        {
          "name": "Login as Sara",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "description": "Logs in as Sara and saves the token. Sara liked comment 1.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"sara.demo@spark.test\",\n    \"password\": \"{{demo_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.accessToken) {",
                  "    pm.collectionVariables.set('token', data.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as Ahmed",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "description": "Logs in as Ahmed and saves the token. Ahmed liked comment 2 and reply 8.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"ahmed.demo@spark.test\",\n    \"password\": \"{{demo_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.accessToken) {",
                  "    pm.collectionVariables.set('token', data.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as Mohamed",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "description": "Logs in as Mohamed and saves the token. Mohamed liked comment 1.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"mohamed.demo@spark.test\",\n    \"password\": \"{{demo_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.accessToken) {",
                  "    pm.collectionVariables.set('token', data.accessToken);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
