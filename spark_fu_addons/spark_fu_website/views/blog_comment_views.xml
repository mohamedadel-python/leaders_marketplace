    <record id="action_spark_blog_reply" model="ir.actions.act_window">
        <field name="name">Replies</field>
        <field name="res_model">spark.blog.comment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('parent_id', '!=', False)]</field>
    </record>

    <record id="view_spark_blog_comment_like_list" model="ir.ui.view">
        <field name="name">spark.blog.comment.like.list</field>
        <field name="model">spark.blog.comment.like</field>
        <field name="arch" type="xml">
            <list string="Likes" create="0">
                <field name="create_date" string="Date"/>
                <field name="post_id"/>
                <field name="comment_id"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_spark_blog_comment_like_search" model="ir.ui.view">
        <field name="name">spark.blog.comment.like.search</field>
        <field name="model">spark.blog.comment.like</field>
        <field name="arch" type="xml">
            <search string="Search Likes">
                <field name="post_id"/>
                <field name="comment_id"/>
                <field name="user_id"/>
                <group expand="0" string="Group By">
                    <filter name="group_post" string="Post" context="{'group_by': 'post_id'}"/>
                    <filter name="group_comment" string="Comment" context="{'group_by': 'comment_id'}"/>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_spark_blog_comment_like" model="ir.actions.act_window">
        <field name="name">Likes</field>
        <field name="res_model">spark.blog.comment.like</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_spark_blog_comments_root"
              name="Comments"
              parent="menu_spark_blog_root"
              sequence="30"/>

    <menuitem id="menu_spark_blog_comments"
              name="Comments"
              parent="menu_spark_blog_comments_root"
              action="action_spark_blog_comment"
              sequence="30"/>

    <!-- <menuitem id="menu_spark_blog_comments_review"
              name="To Review"
              parent="menu_spark_blog_comments_root"
              action="action_spark_blog_comment_review"
              sequence="25"/> -->

    <menuitem id="menu_spark_blog_replies"
              name="Replies"
              parent="menu_spark_blog_comments_root"
              action="action_spark_blog_reply"
              sequence="40"/>

    <menuitem id="menu_spark_blog_likes"
              name="Likes"
              parent="menu_spark_blog_comments_root"
              action="action_spark_blog_comment_like"
              sequence="50"/>
</odoo>
