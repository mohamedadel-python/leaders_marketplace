<odoo>
    <record id="view_partner_form_marketplace" model="ir.ui.view">
        <field name="name">res.partner.form.marketplace</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="before">
                <group name="lm_cod_refusals" invisible="not leaders_cod_refusal_count" groups="leaders_marketplace.group_marketplace_manager">
                    <label for="leaders_cod_refusal_count"/>
                    <div class="o_row">
                        <field name="leaders_cod_refusal_count"/>
                        <button name="action_reset_cod_refusals" type="object" string="Reset COD refusals" class="btn btn-link" icon="fa-refresh" confirm="Reset the Cash on Delivery refusal counter of this customer?"/>
                    </div>
                </group>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Storefront account" name="lm_storefront_account">
                    <group>
                        <group string="Business">
                            <field name="leaders_activity_type"/>
                            <field name="leaders_commercial_register"/>
                        </group>
                        <group string="Notification channels">
                            <field name="leaders_notify_email"/>
                            <field name="leaders_notify_sms"/>
                            <field name="leaders_notify_whatsapp"/>
                            <field name="leaders_notify_promotions" string="Offers"/>
                        </group>
                    </group>
                </page>
                <page string="Marketplace Vendor">
                    <div invisible="not is_marketplace_vendor" groups="leaders_marketplace.group_marketplace_manager,leaders_marketplace.group_marketplace_finance">
                        <button name="%(leaders_marketplace.action_vendor_statement_wizard)d" type="action" string="Vendor Statement" class="btn btn-secondary" icon="fa-file-text-o" context="{'default_vendor_id': id}"/>
                    </div>
                    <group>
                        <group>
                            <field name="is_marketplace_vendor"/>
                            <field name="vendor_state"/>
                            <field name="vendor_tier_id"/>
                            <field name="vendor_kyc_state"/>
                            <field name="leaders_free_until" invisible="not is_marketplace_vendor"/>
                            <field name="leaders_contract_model" invisible="not is_marketplace_vendor"/>
                            <field name="leaders_contract_chosen_on" invisible="not leaders_contract_chosen_on"/>
                            <field name="leaders_subscription_plan_id" invisible="leaders_contract_model != 'subscription'"/>
                            <field name="leaders_subscription_until" invisible="leaders_contract_model != 'subscription'"/>
                            <field name="leaders_listing_paused" invisible="not leaders_listing_paused"/>
                        </group>
                        <group>
                            <field name="vendor_store_name"/>
                            <field name="vendor_store_slug"/>
                            <field name="vendor_location_id"/>
                            <field name="vendor_market_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group>
                        <field name="vendor_hold_days"/>
                        <field name="vendor_min_payout"/>
                        <field name="vendor_payout_bank_id"/>
                        <field name="vendor_wallet_balance" readonly="1"/>
                        <field name="vendor_wallet_hold" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
