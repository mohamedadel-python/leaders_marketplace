<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_leaders_subscription_plan_list" model="ir.ui.view">
        <field name="name">leaders.subscription.plan.list</field>
        <field name="model">leaders.subscription.plan</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="months"/>
                <field name="max_products" string="Products (0: no limit)"/>
                <field name="price"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="note" optional="show"/>
                <field name="highlight" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_leaders_subscription_plan" model="ir.actions.act_window">
        <field name="name">Subscription Plans</field>
        <field name="res_model">leaders.subscription.plan</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html"><p>The plans a subscription vendor picks from: the period, how many products and the price.</p></field>
    </record>
    <menuitem id="menu_leaders_subscription_plan" name="Subscription Plans" parent="menu_configuration"
              action="action_leaders_subscription_plan" sequence="96" groups="leaders_marketplace.group_marketplace_manager"/>

    <record id="view_leaders_subscription_order_list" model="ir.ui.view">
        <field name="name">leaders.subscription.order.list</field>
        <field name="model">leaders.subscription.order</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'pending'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="plan_id"/>
                <field name="price"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state" widget="badge" decoration-info="state == 'pending'" decoration-success="state == 'paid'"/>
                <field name="create_date" string="Requested on"/>
            </list>
        </field>
    </record>
    <record id="view_leaders_subscription_order_form" model="ir.ui.view">
        <field name="name">leaders.subscription.order.form</field>
        <field name="model">leaders.subscription.order</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button name="action_mark_paid" type="object" string="Payment received" class="btn-primary"
                            invisible="state != 'pending'" confirm="Confirm that the vendor paid this subscription? Their products stay on the website for the plan's period."/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="plan_id"/>
                            <field name="months"/>
                            <field name="price"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="paid_on"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_leaders_subscription_order_search" model="ir.ui.view">
        <field name="name">leaders.subscription.order.search</field>
        <field name="model">leaders.subscription.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="vendor_id"/>
                <filter name="pending" string="Waiting for payment" domain="[('state', '=', 'pending')]"/>
                <filter name="paid" string="Paid" domain="[('state', '=', 'paid')]"/>
            </search>
        </field>
    </record>
    <record id="action_leaders_subscription_order" model="ir.actions.act_window">
        <field name="name">Vendor Subscriptions</field>
        <field name="res_model">leaders.subscription.order</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html"><p>The plans vendors picked. Open one and press "Payment received" once the vendor paid: their subscription runs one more period.</p></field>
    </record>
    <menuitem id="menu_leaders_subscription_order" name="Vendor Subscriptions" parent="menu_marketplace_operations"
              action="action_leaders_subscription_order" sequence="13"
              groups="leaders_marketplace.group_marketplace_finance,leaders_marketplace.group_marketplace_manager"/>
</odoo>
