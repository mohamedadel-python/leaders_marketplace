<odoo>
    <!-- Vendor edits of live listings waiting for the platform (the published version stays live meanwhile) -->
    <record id="view_leaders_change_request_list" model="ir.ui.view">
        <field name="name">leaders.change.request.list</field>
        <field name="model">leaders.change.request</field>
        <field name="arch" type="xml">
            <list create="false" decoration-muted="state != 'pending'">
                <field name="create_date" string="Requested"/>
                <field name="product_tmpl_id"/>
                <field name="vendor_id"/>
                <field name="summary"/>
                <field name="state" widget="badge" decoration-info="state == 'pending'" decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>
    <record id="view_leaders_change_request_form" model="ir.ui.view">
        <field name="name">leaders.change.request.form</field>
        <field name="model">leaders.change.request</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button name="action_approve" type="object" string="Approve change" class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_reject" type="object" string="Reject change" invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="product_tmpl_id"/>
                            <field name="offer_id"/>
                            <field name="vendor_id"/>
                        </group>
                        <group>
                            <field name="create_date" string="Requested"/>
                            <field name="reviewer_id" invisible="not reviewer_id"/>
                        </group>
                    </group>
                    <group string="What changes (now → proposed)">
                        <field name="summary" nolabel="1" colspan="2"/>
                        <field name="image_1920" widget="image" options="{'size': [128, 128]}" invisible="not image_1920"/>
                    </group>
                    <group>
                        <field name="reject_reason" placeholder="Required to reject; the vendor sees it." readonly="state != 'pending'"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_leaders_change_request_search" model="ir.ui.view">
        <field name="name">leaders.change.request.search</field>
        <field name="model">leaders.change.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_tmpl_id"/>
                <field name="vendor_id"/>
                <filter name="pending" string="To review" domain="[('state', '=', 'pending')]"/>
            </search>
        </field>
    </record>
    <record id="action_leaders_change_request" model="ir.actions.act_window">
        <field name="name">Changes to Review</field>
        <field name="res_model">leaders.change.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html"><p>Edits vendors made to live listings. The website keeps the published version until a change is approved.</p></field>
    </record>
    <menuitem id="menu_leaders_change_request" name="Changes to Review" parent="menu_marketplace_operations"
              action="action_leaders_change_request" sequence="16" groups="leaders_marketplace.group_marketplace_reviewer"/>
    <record id="action_server_change_request_approve" model="ir.actions.server">
        <field name="name">Approve selected changes</field>
        <field name="model_id" ref="model_leaders_change_request"/>
        <field name="binding_model_id" ref="model_leaders_change_request"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('leaders_marketplace.group_marketplace_reviewer'))]"/>
        <field name="state">code</field>
        <field name="code">records.filtered(lambda r: r.state == 'pending').action_approve()</field>
    </record>
</odoo>
