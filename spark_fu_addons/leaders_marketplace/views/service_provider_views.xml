<odoo>
    <record id="view_service_specialty_list" model="ir.ui.view">
        <field name="name">leaders.service.specialty.list</field>
        <field name="model">leaders.service.specialty</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="slug" readonly="1" optional="show"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="action_service_specialty" model="ir.actions.act_window">
        <field name="name">Provider Specialties</field>
        <field name="res_model">leaders.service.specialty</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_service_provider_list" model="ir.ui.view">
        <field name="name">leaders.service.provider.list</field>
        <field name="model">leaders.service.provider</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'submitted'" decoration-muted="state == 'rejected'">
                <field name="service_id"/>
                <field name="is_platform"/>
                <field name="vendor_id"/>
                <field name="state" widget="badge"/>
                <field name="verified"/>
                <field name="response_hours"/>
                <field name="jobs"/>
            </list>
        </field>
    </record>
    <record id="view_service_provider_form" model="ir.ui.view">
        <field name="name">leaders.service.provider.form</field>
        <field name="model">leaders.service.provider</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state not in ('draft', 'submitted')"/>
                    <button name="action_reject" type="object" string="Refuse"
                            invisible="state not in ('draft', 'submitted')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <group>
                        <group string="Who">
                            <field name="service_id"/>
                            <field name="is_platform"/>
                            <field name="vendor_id" invisible="is_platform" required="not is_platform"/>
                            <field name="name"/>
                            <field name="logo" widget="image" options="{'size': [96, 96]}"/>
                            <field name="verified"/>
                            <field name="reject_reason" invisible="state not in ('submitted', 'rejected')"/>
                        </group>
                        <group string="How">
                            <field name="response_hours"/>
                            <field name="all_governorates"/>
                            <field name="governorate_ids" widget="many2many_tags" invisible="all_governorates"/>
                            <field name="specialty_ids" widget="many2many_tags"/>
                            <field name="jobs"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_service_provider_search" model="ir.ui.view">
        <field name="name">leaders.service.provider.search</field>
        <field name="model">leaders.service.provider</field>
        <field name="arch" type="xml">
            <search>
                <field name="service_id"/>
                <field name="vendor_id"/>
                <filter name="waiting" string="Waiting for approval" domain="[('state', '=', 'submitted')]"/>
                <filter name="platform" string="The platform" domain="[('is_platform', '=', True)]"/>
                <group expand="0" string="Group by">
                    <filter name="by_service" string="Service" context="{'group_by': 'service_id'}"/>
                    <filter name="by_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_service_provider" model="ir.actions.act_window">
        <field name="name">Service Providers</field>
        <field name="res_model">leaders.service.provider</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_waiting': 1}</field>
        <field name="help">Who carries a service out: the platform itself, and the vendors who chose one of the platform's services. A vendor's offer waits here for approval.</field>
    </record>
    <menuitem id="menu_leaders_service_provider" name="Service providers" parent="menu_marketplace_orders"
              action="action_service_provider" sequence="71"/>
    <menuitem id="menu_leaders_service_specialty" name="Provider specialties" parent="menu_configuration"
              action="action_service_specialty" sequence="45"/>
</odoo>
