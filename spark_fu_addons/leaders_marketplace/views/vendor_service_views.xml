<odoo>
    <record id="view_leaders_vendor_service_list" model="ir.ui.view">
        <field name="name">leaders.vendor.service.list</field>
        <field name="model">leaders.vendor.service</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="submitted_on" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"
                       decoration-warning="state == 'submitted'"/>
                <field name="live" widget="boolean" optional="show"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_leaders_vendor_service_form" model="ir.ui.view">
        <field name="name">leaders.vendor.service.form</field>
        <field name="model">leaders.vendor.service</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state not in ('draft', 'submitted')"/>
                    <button name="action_reject" type="object" string="Refuse"
                            invisible="state not in ('draft', 'submitted')"
                            confirm="The vendor is told the reason. Refuse the service?"/>
                    <field name="state" widget="statusbar" statusbar_visible="submitted,approved"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status" invisible="state != 'submitted' or not service_tmpl_id">
                        This is a change of a service that is already on the website. The page keeps its text until you approve.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Service"/></h1>
                        <h3><field name="vendor_id" options="{'no_create': True}"/></h3>
                    </div>
                    <group string="Decision" invisible="state not in ('draft', 'submitted', 'rejected')">
                        <field name="reject_reason" placeholder="Write the reason here, then press Refuse"/>
                    </group>
                    <group>
                        <group string="The card and the page">
                            <field name="summary"/>
                            <field name="description"/>
                            <field name="request_title"/>
                            <field name="deliverable"/>
                            <field name="icon" widget="image" options="{'size': [96, 96]}"/>
                        </group>
                        <group string="Scope">
                            <field name="includes"/>
                            <field name="excludes"/>
                            <field name="checklist_title"/>
                            <field name="checklist"/>
                            <field name="coverage"/>
                            <field name="warranty_months"/>
                        </group>
                    </group>
                    <group>
                        <group string="Offered with">
                            <field name="product_tmpl_ids" widget="many2many_tags" nolabel="1"
                                   domain="[('marketplace_owner_vendor_id', '=', vendor_id)]" options="{'no_create': True}"/>
                        </group>
                        <group string="On the website">
                            <field name="slug"/>
                            <field name="service_tmpl_id"/>
                            <field name="live"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_leaders_vendor_service_search" model="ir.ui.view">
        <field name="name">leaders.vendor.service.search</field>
        <field name="model">leaders.vendor.service</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="vendor_id"/>
                <filter name="submitted" string="Waiting for approval" domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="rejected" string="Refused" domain="[('state', '=', 'rejected')]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group><filter name="by_vendor" string="Vendor" context="{'group_by': 'vendor_id'}"/></group>
            </search>
        </field>
    </record>
    <record id="action_leaders_vendor_service" model="ir.actions.act_window">
        <field name="name">Vendors' own services</field>
        <field name="res_model">leaders.vendor.service</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_submitted': 1}</field>
        <field name="help" type="html"><p>The services vendors offer. A vendor writes one in the vendor portal and sends it; once you approve it, it is a service page of the website and its requests go to the vendor.</p></field>
    </record>
    <menuitem id="menu_leaders_vendor_service" name="Vendors' own services" parent="menu_marketplace_orders"
              action="action_leaders_vendor_service" sequence="70"/>
</odoo>
