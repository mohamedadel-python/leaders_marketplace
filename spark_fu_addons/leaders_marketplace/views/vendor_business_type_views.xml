<odoo>
    <record id="view_vendor_business_type_list" model="ir.ui.view">
        <field name="name">leaders.vendor.business.type.list</field>
        <field name="model">leaders.vendor.business.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_vendor_business_type" model="ir.actions.act_window">
        <field name="name">Vendor Business Types</field>
        <field name="res_model">leaders.vendor.business.type</field>
        <field name="view_mode">list</field>
        <field name="context">{"active_test": False}</field>
    </record>

    <menuitem id="menu_vendor_business_types" name="Vendor Business Types" parent="menu_configuration"
              action="action_vendor_business_type" sequence="12"/>
</odoo>
