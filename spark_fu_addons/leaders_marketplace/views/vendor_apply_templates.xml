<odoo>
    <!-- one input of the application form: label, control, error; the control comes from the caller's body -->
    <template id="vendor_apply_field" name="Vendor Apply Field">
        <div t-attf-class="lm-af-field #{'lm-af-wide' if wide else ''} #{'has-error' if field_errors.get(name) else ''}">
            <label class="lm-af-label" t-att-for="'lm_af_%s' % name"><span t-if="required" class="lm-af-req">*</span> <t t-out="label"/></label>
            <t t-out="0"/>
            <div class="lm-af-error" t-att-data-for="name" t-esc="field_errors.get(name) or ''"/>
        </div>
    </template>

    <!-- a dashed drop zone for one document -->
    <template id="vendor_apply_upload" name="Vendor Apply Upload">
        <label class="lm-af-drop" t-att-for="'lm_af_%s' % name">
            <input type="file" class="lm-af-file" t-att-id="'lm_af_%s' % name" t-att-name="name"
                   accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" t-att-data-lm-required="'1' if required else None"/>
            <i class="fa fa-cloud-upload lm-af-drop-icon" aria-hidden="true"/>
            <span class="lm-af-drop-title"><t t-out="title"/></span>
            <span class="lm-af-drop-hint" dir="ltr">jpg, png, pdf · <t t-esc="max_mb"/> MB</span>
            <span class="lm-af-drop-file"/>
        </label>
        <div t-if="kept_documents.get(name[4:])" class="lm-af-kept small text-muted mt-1">
            Uploaded before: <bdi t-esc="kept_documents[name[4:]]"/>. Choose a file only to replace it.
        </div>
    </template>

    <template id="vendor_apply_form" name="Apply to Sell">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container lm-af" id="lm_apply_page">
                    <h1 class="lm-af-title">Apply to sell on our platform</h1>
                    <div class="lm-af-progress">
                        <div class="lm-af-stepline"><span>Step</span> <span class="lm-af-current" t-esc="step"/> <span>of 3</span></div>
                        <div class="lm-af-bars" aria-hidden="true"><span/><span/><span/></div>
                    </div>
                    <hr class="lm-af-rule"/>

                    <div t-if="blocked" class="alert alert-warning" role="alert" id="lm_apply_blocked">
                        <p class="mb-2" t-esc="blocked"/>
                        <a href="/web/session/logout?redirect=/vendor/apply" class="btn btn-sm btn-outline-dark">Sign in with another account</a>
                    </div>
                    <div t-if="previous" class="alert alert-info" id="lm_apply_again">
                        You are filing application <strong t-esc="previous.name"/> again. Fix what was refused and send it.
                        <div t-if="previous.reject_reason" class="mt-1">Reason: <t t-esc="previous.reject_reason"/></div>
                    </div>
                    <div t-if="errors or field_errors" class="alert alert-danger lm-af-alert" role="alert" id="lm_form_error">
                        <ul class="mb-0" t-if="errors"><li t-foreach="errors" t-as="e" t-esc="e"/></ul>
                        <p class="mb-0" t-if="field_errors">Please correct the fields marked in red. Files are not kept after an error: choose them again.</p>
                    </div>

                    <span hidden="hidden" id="lm_af_msg_required">This field is required.</span>
                    <span hidden="hidden" id="lm_af_msg_email">Enter a valid email address.</span>
                    <span hidden="hidden" id="lm_af_msg_tax">The tax number is 9 digits.</span>
                    <span hidden="hidden" id="lm_af_msg_cr">The commercial registration number is 3 to 10 digits.</span>
                    <span hidden="hidden" id="lm_af_msg_categories">Choose at least one category.</span>

                    <form t-if="not blocked" id="lm_apply_form" method="post" action="/vendor/apply" enctype="multipart/form-data" novalidate="novalidate"
                          t-attf-data-step="#{step}">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input t-if="previous" type="hidden" name="again" value="1"/>
                        <div style="position:absolute; inset-inline-start:-9999px;" aria-hidden="true">
                            <label>Leave this field empty <input type="text" name="website_url" tabindex="-1" autocomplete="off"/></label>
                        </div>

                        <section class="lm-af-step" data-step="1">
                            <h2 class="lm-af-section">1. Business information</h2>
                            <div class="lm-af-grid">
                                <t t-call="leaders_marketplace.vendor_apply_field">
                                    <t t-set="name" t-value="'owner_name'"/><t t-set="required" t-value="True"/>
                                    <t t-set="label">Full name</t>
                                    <input class="lm-af-input" id="lm_af_owner_name" name="owner_name" t-att-value="v.get('owner_name')"
                                           data-lm-required="1" autocomplete="name" t-att-placeholder="label"/>
                                </t>
                                <t t-call="leaders_marketplace.vendor_apply_field">
                                    <t t-set="name" t-value="'business_name'"/><t t-set="required" t-value="True"/>
                                    <t t-set="label">Company name</t>
                                    <input class="lm-af-input" id="lm_af_business_name" name="business_name" t-att-value="v.get('business_name')"
                                           data-lm-required="1" autocomplete="organization" t-att-placeholder="label"/>
                                </t>
                                <t t-call="leaders_marketplace.vendor_apply_field">
                                    <t t-set="name" t-value="'owner_phone'"/><t t-set="required" t-value="True"/>
                                    <t t-set="label">Phone number</t>
                                    <input class="lm-af-input" id="lm_af_owner_phone" name="owner_phone" type="tel" dir="ltr"
                                           t-att-value="v.get('owner_phone')" data-lm-required="1" autocomplete="tel" t-att-placeholder="label"/>
                                </t>
                                <t t-call="leaders_marketplace.vendor_apply_field">
                                    <t t-set="name" t-value="'owner_email'"/><t t-set="required" t-value="True"/>
                                    <t t-set="label">Email</t>
                                    <input class="lm-af-input" id="lm_af_owner_email" name="owner_email" type="email" dir="ltr"
                                           t-att-value="applicant_email" readonly="readonly" data-lm-required="1" autocomplete="email" t-att-placeholder="label"/>
                                    <div class="small text-muted mt-1">The email of your account. You sign in to the vendor portal with the same account.</div>
                                </t>
                                <t t-call="leaders_marketplace.vendor_apply_field">
                                    <t t-set="name" t-value="'business_type_id'"/><t t-set="required" t-value="True"/>
                                    <t t-set="label">Business type</t>
                                    <select class="lm-af-input lm-af-select" id="lm_af_business_type_id" name="business_type_id" data-lm-required="1">
                                        <option value="">Choose the business type</option>
                                        <option t-foreach="business_types" t-as="bt" t-att-value="bt.id"
                                                t-att-selected="str(bt.id) == v.get('business_type_id')" t-esc="bt.name"/>
                                    </select>
                                </t>
                                <t t-call="leaders_marketplace.vendor_apply_field">
                                    <t t-set="name" t-value="'state_id'"/><t t-set="required" t-value="True"/>
                                    <t t-set="label">Governorate</t>
                                    <select class="lm-af-input lm-af-select" id="lm_af_state_id" name="state_id" data-lm-required="1">
                                        <option value="">Choose the governorate</option>
                                        <option t-foreach="governorates" t-as="gov" t-att-value="gov[0].id"
                                                t-att-selected="str(gov[0].id) == v.get('state_id')" t-esc="gov[1]"/>
                                    </select>
                                </t>
                                <t t-call="leaders_marketplace.vendor_apply_field">
                                    <t t-set="name" t-value="'doc_id_passport'"/><t t-set="required" t-value="'id_passport' not in kept_documents"/><t t-set="wide" t-value="True"/>
                                    <t t-set="label">ID / Passport</t>
                                    <t t-call="leaders_marketplace.vendor_apply_upload">
                                        <t t-set="title">Upload a photo of your ID or passport</t>
                                    </t>
                                </t>
                            </div>
                        </section>

                        <section class="lm-af-step" data-step="2">
                            <h2 class="lm-af-section">2. Legal information</h2>
                            <div class="lm-af-grid">
                                <t t-call="leaders_marketplace.vendor_apply_field">
                                    <t t-set="name" t-value="'commercial_registration_number'"/><t t-set="required" t-value="False"/>
                                    <t t-set="label">Commercial registration number</t>
                                    <input class="lm-af-input" id="lm_af_commercial_registration_number" name="commercial_registration_number"
                                           inputmode="numeric" maxlength="14" data-lm-check="^[0-9]{3,10}$" data-lm-msg="lm_af_msg_cr"
                                           t-att-value="v.get('commercial_registration_number')"/>
                                </t>
                                <t t-call="leaders_marketplace.vendor_apply_field">
                                    <t t-set="name" t-value="'tax_number'"/><t t-set="required" t-value="False"/>
                                    <t t-set="label">Tax number / VAT registration number</t>
                                    <input class="lm-af-input" id="lm_af_tax_number" name="tax_number" inputmode="numeric" maxlength="13"
                                           placeholder="123-456-789" data-lm-check="^[0-9]{9}$" data-lm-msg="lm_af_msg_tax"
                                           t-att-value="v.get('tax_number')"/>
                                </t>
                                <t t-call="leaders_marketplace.vendor_apply_field">
                                    <t t-set="name" t-value="'doc_commercial_register'"/><t t-set="required" t-value="False"/>
                                    <t t-set="label">Commercial register</t>
                                    <t t-call="leaders_marketplace.vendor_apply_upload"><t t-set="title">Upload files</t></t>
                                </t>
                                <t t-call="leaders_marketplace.vendor_apply_field">
                                    <t t-set="name" t-value="'doc_tax_certificate'"/><t t-set="required" t-value="False"/>
                                    <t t-set="label">Tax card</t>
                                    <t t-call="leaders_marketplace.vendor_apply_upload"><t t-set="title">Upload files</t></t>
                                </t>
                            </div>
                        </section>

                        <section class="lm-af-step" data-step="3">
                            <h2 class="lm-af-section">3. Products and operations</h2>
                            <div class="lm-af-grid">
                                <t t-call="leaders_marketplace.vendor_apply_field">
                                    <t t-set="name" t-value="'product_category_ids'"/><t t-set="required" t-value="True"/>
                                    <t t-set="label">Product categories</t>
                                    <select class="lm-af-input lm-af-select" id="lm_af_product_category_ids" data-lm-categories="1">
                                        <option value="">Choose the categories</option>
                                        <optgroup t-foreach="category_groups" t-as="group" t-att-label="group[0].name">
                                            <option t-att-value="group[0].id" t-att-disabled="group[0] in selected_categories" t-esc="group[0].name"/>
                                            <option t-foreach="group[1]" t-as="child" t-att-value="child.id"
                                                    t-att-disabled="child in selected_categories" t-esc="child.name"/>
                                        </optgroup>
                                    </select>
                                    <div class="lm-af-chips" id="lm_af_chips">
                                        <span class="lm-af-chip" t-foreach="selected_categories" t-as="cat">
                                            <input type="hidden" name="product_category_ids" t-att-value="cat.id"/>
                                            <span t-esc="cat.name"/>
                                            <button type="button" class="lm-af-chip-x"><i class="fa fa-times" aria-hidden="true"/><span class="visually-hidden">Remove</span></button>
                                        </span>
                                    </div>
                                </t>
                                <t t-call="leaders_marketplace.vendor_apply_field">
                                    <t t-set="name" t-value="'delivery_method'"/><t t-set="required" t-value="False"/>
                                    <t t-set="label">Delivery method</t>
                                    <input class="lm-af-input" id="lm_af_delivery_method" name="delivery_method" t-att-value="v.get('delivery_method')"/>
                                </t>
                                <div t-attf-class="lm-af-field lm-af-wide #{'has-error' if field_errors.get('products_sheet') else ''}">
                                    <label class="lm-af-label" for="lm_af_products_sheet">Your products (optional)</label>
                                    <p class="small text-muted mb-1">Add your products now with the products sheet, or one by one from your vendor portal once you are approved.
                                        <a href="/vendor/apply/products-template.xlsx">Download the products sheet</a>.</p>
                                    <input type="file" class="lm-af-input" id="lm_af_products_sheet" name="products_sheet"
                                           accept=".xlsx,.csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv"/>
                                    <div class="lm-af-error" data-for="products_sheet" t-esc="field_errors.get('products_sheet') or ''"/>
                                </div>
                                <t t-call="leaders_marketplace.vendor_apply_field">
                                    <t t-set="name" t-value="'business_activity'"/><t t-set="required" t-value="False"/><t t-set="wide" t-value="True"/>
                                    <t t-set="label">About your business and products</t>
                                    <t t-set="hint">Enter the text</t>
                                    <textarea class="lm-af-input lm-af-textarea" id="lm_af_business_activity" name="business_activity" rows="4"
                                              t-att-placeholder="hint" t-out="v.get('business_activity') or ''"/>
                                </t>
                            </div>
                            <div class="lm-af-checks">
                                <div t-attf-class="lm-af-check #{'has-error' if field_errors.get('terms_accepted') else ''}">
                                    <label><input type="checkbox" name="terms_accepted" value="1" data-lm-required="1" t-att-checked="v.get('terms_accepted')"/>
                                        <span>I agree to the <a href="/vendor/apply/terms" target="_blank">platform selling terms</a> and the <a t-att-href="privacy_url" target="_blank">privacy policy</a> <span class="lm-af-req">*</span></span></label>
                                    <div class="lm-af-error" data-for="terms_accepted" t-esc="field_errors.get('terms_accepted') or ''"/>
                                </div>
                                <div t-attf-class="lm-af-check #{'has-error' if field_errors.get('data_confirmed') else ''}">
                                    <label><input type="checkbox" name="data_confirmed" value="1" data-lm-required="1" t-att-checked="v.get('data_confirmed')"/>
                                        <span>I confirm that all the data and documents I provided are correct <span class="lm-af-req">*</span></span></label>
                                    <div class="lm-af-error" data-for="data_confirmed" t-esc="field_errors.get('data_confirmed') or ''"/>
                                </div>
                            </div>
                        </section>

                        <template id="lm_af_chip_tpl">
                            <span class="lm-af-chip"><input type="hidden" name="product_category_ids"/><span class="lm-af-chip-name"/><button type="button" class="lm-af-chip-x"><i class="fa fa-times" aria-hidden="true"/><span class="visually-hidden">Remove</span></button></span>
                        </template>

                        <div class="lm-af-actions">
                            <button type="button" id="lm_prev" class="lm-af-btn lm-af-btn-outline">Previous</button>
                            <button type="button" id="lm_next" class="lm-af-btn lm-af-btn-primary">Next</button>
                            <button type="submit" id="lm_submit" class="lm-af-btn lm-af-btn-primary" data-lm-loading="1">Submit</button>
                        </div>
                    </form>
                </div>
                <script type="text/javascript">
                    (function () {
                        var form = document.getElementById('lm_apply_form');
                        if (!form) { return; }
                        var steps = [].slice.call(form.querySelectorAll('.lm-af-step'));
                        var bars = [].slice.call(document.querySelectorAll('.lm-af-bars span'));
                        var current = document.querySelector('.lm-af-current');
                        var prev = document.getElementById('lm_prev');
                        var next = document.getElementById('lm_next');
                        var submit = document.getElementById('lm_submit');
                        var chips = document.getElementById('lm_af_chips');
                        var catSelect = form.querySelector('[data-lm-categories]');
                        var chipTpl = document.getElementById('lm_af_chip_tpl');
                        var i = Math.max(0, Math.min(steps.length - 1, (parseInt(form.getAttribute('data-step'), 10) || 1) - 1));
                        function text(id) { return document.getElementById(id).textContent; }
                        function show() {
                            steps.forEach(function (s, n) { s.hidden = n !== i; });
                            bars.forEach(function (b, n) { b.classList.toggle('is-done', n &lt;= i); });
                            current.textContent = i + 1;
                            prev.hidden = i === 0;
                            next.hidden = i === steps.length - 1;
                            submit.hidden = i !== steps.length - 1;
                        }
                        function setError(name, message) {
                            var box = form.querySelector('.lm-af-error[data-for="' + name + '"]');
                            if (!box) { return; }
                            box.textContent = message || '';
                            box.parentElement.classList.toggle('has-error', !!message);
                        }
                        function validStep() {
                            var ok = true;
                            steps[i].querySelectorAll('[data-lm-required]').forEach(function (el) {
                                var msg = '';
                                if (el.type === 'checkbox') { msg = el.checked ? '' : text('lm_af_msg_required'); }
                                else if (el.type === 'file') { msg = el.files.length ? '' : text('lm_af_msg_required'); }
                                else if (!el.value.trim()) { msg = text('lm_af_msg_required'); }
                                else if (el.type === 'email' &amp;&amp; !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(el.value.trim())) { msg = text('lm_af_msg_email'); }
                                setError(el.name, msg);
                                if (msg) { ok = false; }
                            });
                            // numbers with a fixed shape (tax number, commercial registration): Arabic digits, spaces
                            // and dashes are accepted, the digits are checked
                            steps[i].querySelectorAll('[data-lm-check]').forEach(function (el) {
                                var raw = el.value.trim();
                                if (!raw) { return; }
                                var digits = raw.replace(/[\u0660-\u0669]/g, function (d) { return String(d.charCodeAt(0) - 0x0660); })
                                                .replace(/[\u06F0-\u06F9]/g, function (d) { return String(d.charCodeAt(0) - 0x06F0); })
                                                .replace(/[\s-]/g, '');
                                var msg = new RegExp(el.getAttribute('data-lm-check')).test(digits) ? '' : text(el.getAttribute('data-lm-msg'));
                                setError(el.name, msg);
                                if (msg) { ok = false; }
                            });
                            if (steps[i].contains(catSelect)) {
                                var none = !chips.querySelector('input[name="product_category_ids"]');
                                setError('product_category_ids', none ? text('lm_af_msg_categories') : '');
                                if (none) { ok = false; }
                            }
                            if (!ok) {
                                var first = steps[i].querySelector('.has-error');
                                if (first) { first.scrollIntoView({ block: 'center' }); }
                            }
                            return ok;
                        }
                        prev.addEventListener('click', function () { i = Math.max(0, i - 1); show(); window.scrollTo(0, 0); });
                        next.addEventListener('click', function () {
                            if (validStep()) { i = Math.min(steps.length - 1, i + 1); show(); window.scrollTo(0, 0); }
                        });
                        form.addEventListener('submit', function (ev) { if (!validStep()) { ev.preventDefault(); ev.stopImmediatePropagation(); } }, true);
                        form.querySelectorAll('.lm-af-file').forEach(function (input) {
                            input.addEventListener('change', function () {
                                var label = input.closest('.lm-af-drop');
                                label.querySelector('.lm-af-drop-file').textContent = input.files.length ? input.files[0].name : '';
                                label.classList.toggle('has-file', !!input.files.length);
                                setError(input.name, '');
                            });
                        });
                        form.querySelectorAll('[data-lm-check]').forEach(function (el) {
                            el.addEventListener('input', function () { setError(el.name, ''); });
                        });
                        form.querySelectorAll('[data-lm-required]').forEach(function (el) {
                            // clear while typing: clearing on blur would move the button under the pointer
                            el.addEventListener(el.tagName === 'SELECT' || el.type === 'checkbox' || el.type === 'file' ? 'change' : 'input',
                                                function () { setError(el.name, ''); });
                        });
                        function removeChip(chip) {
                            var id = chip.querySelector('input').value;
                            var option = catSelect.querySelector('option[value="' + id + '"]');
                            if (option) { option.disabled = false; }
                            chip.remove();
                        }
                        chips.addEventListener('click', function (ev) {
                            var x = ev.target.closest('.lm-af-chip-x');
                            if (x) { removeChip(x.closest('.lm-af-chip')); }
                        });
                        catSelect.addEventListener('change', function () {
                            var option = catSelect.options[catSelect.selectedIndex];
                            if (!option || !option.value) { return; }
                            var chip = chipTpl.content.firstElementChild.cloneNode(true);
                            chip.querySelector('input').value = option.value;
                            chip.querySelector('.lm-af-chip-name').textContent = option.textContent;
                            chips.appendChild(chip);
                            option.disabled = true;
                            catSelect.value = '';
                            setError('product_category_ids', '');
                        });
                        show();
                    })();
                </script>
            </div>
        </t>
    </template>

    <!-- before the form, for a visitor who is not signed in: confirm an email with a code. The account of that
         email is used (a new customer account when there is none), then the visitor fills the same form. -->
    <template id="vendor_apply_email" name="Apply to Sell: Email">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container lm-af" id="lm_apply_email_page" style="max-width: 640px;">
                    <h1 class="lm-af-title">Apply to sell on our platform</h1>
                    <p class="text-muted">Start with your email. We send you a code to confirm it.</p>
                    <ul class="text-muted small mb-0">
                        <li>Already have an account with this email? Your application is filed with that account, and it becomes your seller account once approved.</li>
                        <li>A new email? We create your account with it.</li>
                    </ul>
                    <hr class="lm-af-rule"/>
                    <div t-if="error" class="alert alert-danger lm-af-alert" role="alert" id="lm_email_error" t-esc="error"/>

                    <form t-if="not sent" method="post" action="/vendor/apply/email" id="lm_email_form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="action" value="send"/>
                        <div class="lm-af-grid">
                            <div class="lm-af-field lm-af-wide">
                                <label class="lm-af-label" for="lm_af_owner_name"><span class="lm-af-req">*</span> Full name</label>
                                <input type="text" class="lm-af-input" id="lm_af_owner_name" name="owner_name" required="required"
                                       maxlength="80" autocomplete="name" t-att-value="owner_name" placeholder="Full name"/>
                            </div>
                            <div class="lm-af-field lm-af-wide">
                                <label class="lm-af-label" for="lm_af_email"><span class="lm-af-req">*</span> Email</label>
                                <input type="email" class="lm-af-input" id="lm_af_email" name="email" required="required" dir="ltr"
                                       autocomplete="email" t-att-value="email" placeholder="name@example.com"/>
                            </div>
                        </div>
                        <div class="lm-af-actions">
                            <button type="submit" class="lm-af-btn lm-af-btn-primary" id="lm_email_send" style="margin-inline-start: auto;">Send the code</button>
                        </div>
                    </form>

                    <t t-if="sent">
                        <div class="alert alert-info" id="lm_email_sent">
                            <p class="mb-1">We sent a 6-digit code to</p>
                            <p class="mb-1" dir="ltr"><strong t-esc="email"/></p>
                            <p class="mb-0">The code expires in 15 minutes. Check your spam folder if you do not see it.</p>
                        </div>
                        <form method="post" action="/vendor/apply/email" id="lm_code_form">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="action" value="verify"/>
                            <div class="lm-af-field">
                                <label class="lm-af-label" for="lm_af_code"><span class="lm-af-req">*</span> Code</label>
                                <input type="text" class="lm-af-input" id="lm_af_code" name="code" required="required" dir="ltr"
                                       inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" placeholder="123456"/>
                            </div>
                            <div class="lm-af-actions">
                                <button type="submit" class="lm-af-btn lm-af-btn-primary" id="lm_code_verify" style="margin-inline-start: auto;">Confirm and continue</button>
                            </div>
                        </form>
                        <form method="post" action="/vendor/apply/email" class="mt-3" id="lm_code_resend">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="action" value="send"/>
                            <input type="hidden" name="email" t-att-value="email"/>
                            <input type="hidden" name="owner_name" t-att-value="owner_name"/>
                            <button type="submit" class="btn btn-link p-0 me-4">Send a new code</button>
                            <a href="/vendor/apply" class="btn btn-link p-0">Use another email</a>
                        </form>
                    </t>
                    <p class="mt-4 small text-muted">Already signed up? <a href="/web/login?redirect=/vendor/apply">Sign in</a></p>
                </div>
            </div>
        </t>
    </template>

    <template id="vendor_apply_terms" name="Vendor Selling Terms">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container lm-af">
                    <h1 class="lm-af-title">Platform selling terms</h1>
                    <t t-if="terms">
                        <p class="text-muted"><t t-esc="terms.name"/> · v<t t-esc="terms.version"/></p>
                        <div class="lm-af-terms" t-out="terms.body"/>
                    </t>
                    <p t-else="">The selling terms are not published yet.</p>
                </div>
            </div>
        </t>
    </template>

    <template id="vendor_apply_status" name="Vendor Application Status">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container my-5 lm-portal lm-apply" id="lm_apply_status_page">
                    <div t-if="submitted" class="alert alert-success">
                        Thank you! Your application <strong t-esc="application.name"/> was received. We sent you an email with this page's link.
                    </div>
                    <div t-if="reuploaded" class="alert alert-success">The document was replaced and will be checked again.</div>
                    <div t-if="error" class="alert alert-danger" role="alert" id="lm_form_error" t-esc="error"/>
                    <div class="lm-page-header">
                        <div>
                            <div class="lm-page-heading">
                                <h1 class="lm-page-title">Application <span t-esc="application.name"/></h1>
                                <t t-call="leaders_marketplace.lm_state_badge"><t t-set="lm_record" t-value="application"/></t>
                            </div>
                            <p class="lm-page-subtitle">Status: <span t-esc="state_label"/></p>
                        </div>
                    </div>
                    <div t-if="application.state == 'rejected'" class="alert alert-danger" id="lm_apply_rejected">
                        <div t-if="application.reject_reason">Rejected: <t t-esc="application.reject_reason"/></div>
                        <a href="/vendor/apply?again=1" class="btn btn-primary btn-sm mt-2" id="lm_apply_again_btn">Apply again</a>
                    </div>
                    <div t-if="missing and application.state != 'approved'" class="card mb-4" id="lm_apply_missing">
                        <div class="card-body">
                            <h5>Still needed</h5>
                            <ul class="mb-0"><li t-foreach="missing" t-as="m" t-esc="m"/></ul>
                        </div>
                    </div>
                    <h2 class="lm-section-title">Documents</h2>
                    <t t-set="lb_file">File</t>
                    <t t-set="lb_status">Status</t>
                    <t t-set="lb_note">Note</t>
                    <div class="lm-table-responsive">
                    <table class="table align-middle lm-table">
                        <thead><tr><th>Document</th><th>File</th><th>Status</th><th>Note</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
                        <tbody>
                            <tr t-foreach="application.document_ids" t-as="d">
                                <td class="lm-cell-title" t-esc="d.name"/>
                                <td t-att-data-label="lb_file" class="text-break" t-esc="d.file_name"/>
                                <td t-att-data-label="lb_status"><t t-call="leaders_marketplace.lm_state_badge"><t t-set="lm_record" t-value="d"/><t t-set="lm_field" t-value="'verification_status'"/></t></td>
                                <td t-att-data-label="lb_note" t-esc="d.notes if d.verification_status == 'rejected' else ''"/>
                                <td class="lm-cell-actions">
                                    <form t-if="can_reupload and d.verification_status == 'rejected'" method="post" enctype="multipart/form-data"
                                          t-attf-action="/vendor/apply/status/#{application.access_token}/document/#{d.id}" class="lm-inline-form">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <input type="file" name="file" class="form-control form-control-sm" accept="application/pdf,image/*" aria-label="Replace"/>
                                        <button class="btn btn-sm btn-primary text-nowrap" data-lm-loading="1">Replace</button>
                                    </form>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Optional footer link: enable it from the website's Customize menu. -->
    <template id="footer_sell_link" inherit_id="website.footer_custom" name="Sell on Leaders link" active="False" customize_show="True">
        <xpath expr="(//ul[hasclass('list-unstyled')])[1]" position="inside">
            <li t-if="request.env['ir.config_parameter'].sudo().get_param('leaders_marketplace.vendor_apply_enabled') in ('True', 'true', '1')"><a href="/vendor/apply">Sell on Leaders</a></li>
        </xpath>
    </template>
</odoo>
