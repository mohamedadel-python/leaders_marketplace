<odoo>
    <record id="res_config_settings_view_form_marketplace" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.marketplace</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Marketplace" name="leaders_marketplace">
                    <block title="Push Notifications">
                        <setting string="Push notifications" help="Customers, vendors and the back office get a push on their phones (Firebase) for the events that already send an email, even while the app is closed. Each event keeps its own on/off setting and the customer's preferences.">
                            <field name="marketplace_push_enabled"/>
                            <div class="mt-2" invisible="not marketplace_push_enabled">
                                <label for="marketplace_push_credentials" class="o_light_label"/>
                                <field name="marketplace_push_credentials" password="True"/>
                            </div>
                            <div class="mt-2" invisible="not marketplace_push_enabled">
                                <field name="marketplace_push_staff"/>
                                <label for="marketplace_push_staff" class="o_light_label"/>
                            </div>
                            <div class="mt-2" invisible="not marketplace_push_enabled">
                                <button name="action_push_test" type="object" string="Send a test to my phone" class="btn-secondary"/>
                            </div>
                        </setting>
                    </block>
                    <block title="Vendor Finance &amp; Returns">
                        <setting string="Rent margin" help="The platform rents the vendor's machine and re-rents it in its own name: the customer pays the vendor's daily price plus this margin. A subcategory or a machine can override it.">
                            <field name="marketplace_rent_margin_percent"/>
                            <div class="mt-2">
                                <label for="marketplace_rent_margin_min" class="o_light_label"/>
                                <field name="marketplace_rent_margin_min"/>
                            </div>
                        </setting>
                        <setting string="Inspection that does not match" help="The vendor pays the inspection when it shows the product does not match its listing: deducted from the next settlement, or billed on its own invoice. The reviewer can change the amount and the way for one case.">
                            <field name="marketplace_inspection_fee_mode" widget="radio"/>
                            <div class="mt-2">
                                <label for="marketplace_inspection_fee_amount" class="o_light_label"/>
                                <field name="marketplace_inspection_fee_amount"/>
                            </div>
                        </setting>
                        <setting string="Default Vendor Hold Days">
                            <field name="marketplace_default_hold_days"/>
                        </setting>
                        <setting string="Return Window" help="Days after shipping during which a customer can request a return.">
                            <field name="marketplace_return_window_days"/>
                        </setting>
                        <setting string="Returns &amp; Disputes Center" help="Reason codes, photos, refund or exchange and pickup dates on the customer's return form, plus the returns page with next steps, deadlines and a detail page. Off keeps the current return form and page.">
                            <field name="marketplace_returns_center_enabled"/>
                            <div class="mt-2" invisible="not marketplace_returns_center_enabled">
                                <label for="marketplace_return_shipping_fee" class="o_light_label"/>
                                <field name="marketplace_return_shipping_fee"/>
                            </div>
                            <div class="mt-2" invisible="not marketplace_returns_center_enabled">
                                <label for="marketplace_return_pickup_max_days" class="o_light_label"/>
                                <field name="marketplace_return_pickup_max_days"/>
                            </div>
                        </setting>
                        <setting string="Vendor Order Cancellation" help="Let a vendor owner cancel an unshipped order from the portal.">
                            <field name="marketplace_vendor_can_cancel_orders"/>
                        </setting>
                        <setting string="Customer Order Cancellation" help="Let customers cancel a whole checkout or one seller's part from their order page while nothing has shipped. 0 hours = no time limit.">
                            <field name="marketplace_customer_can_cancel_orders"/>
                            <div class="mt-2" invisible="not marketplace_customer_can_cancel_orders">
                                <label for="marketplace_cancel_window_hours" class="o_light_label"/>
                                <field name="marketplace_cancel_window_hours"/>
                            </div>
                        </setting>
                        <setting string="Unified My Orders" help="One My orders list with a row per checkout (company order and every seller), an order page grouped by seller and Buy again. Off keeps the current lists.">
                            <field name="marketplace_unified_customer_orders"/>
                        </setting>
                        <setting string="Standard Portal Entries" help="Which of Odoo's own entries (Quotations, Sales Orders, Invoices, other apps) appear on the customer's My Account home. Marketplace entries always appear.">
                            <field name="marketplace_portal_show_standard_entries"/>
                        </setting>
                        <setting string="Payout Account Changes" help="A settlement cannot be marked paid while its vendor has a payout account change waiting for review. Registering money received from a vendor is never blocked.">
                            <field name="marketplace_block_payout_on_pending_bank_change"/>
                        </setting>
                        <setting string="Vendor-Only Checkouts" help="Hide vendor-only checkouts from the customer's Orders list, show the real total on the confirmation page and send one Marketplace order confirmation email.">
                            <field name="marketplace_vendor_only_presentation"/>
                        </setting>
                        <setting string="Marketplace Warehouse (FBL)" help="Off when the marketplace has no warehouse of its own: vendors then ship their own goods (FBM only) and FBL is hidden and refused everywhere. Cannot be turned off while active FBL offers or FBL stock exist.">
                            <field name="marketplace_fbl_enabled"/>
                        </setting>
                        <setting string="Public Vendor Application" help="Let visitors apply to sell at /vendor/apply.">
                            <field name="marketplace_vendor_apply_enabled"/>
                            <div class="content-group" invisible="not marketplace_vendor_apply_enabled">
                                <div class="mt8"><label for="marketplace_vendor_apply_daily_limit"/> <field name="marketplace_vendor_apply_daily_limit"/></div>
                                <div class="mt8"><label for="marketplace_vendor_document_max_mb"/> <field name="marketplace_vendor_document_max_mb"/></div>
                            </div>
                        </setting>
                        <setting string="Approve vendors automatically" help="On: a website application is approved the moment it is sent; the documents are reviewed afterwards. Off: it waits until you approve it in Vendor Applications.">
                            <field name="marketplace_vendor_instant_activation"/>
                        </setting>
                        <setting string="Publisher of commission products" help="The seller name the buyer sees on the products of a commission vendor. Subscription vendors and vendors in their free period always show their own name, and their orders go to them directly.">
                            <field name="marketplace_commission_publisher" widget="radio"/>
                        </setting>
                        <setting string="Free period and grace days" help="How long a new vendor sells for free, and how many days the products stay on the website after a subscription or a free period ends before they are hidden.">
                            <div class="mt8"><label for="marketplace_free_period_months"/> <field name="marketplace_free_period_months" class="oe_inline"/></div>
                            <div class="mt8"><label for="marketplace_subscription_grace_days"/> <field name="marketplace_subscription_grace_days" class="oe_inline"/></div>
                            <div class="mt8"><label for="marketplace_subscription_remind_days"/> <field name="marketplace_subscription_remind_days" class="oe_inline"/></div>
                        </setting>
                        <setting string="Send rent requests to the vendor" help="Off: rent requests stay with the platform, which rents the machine in its own name. On: the vendor who owns the machine also sees them in the vendor portal.">
                            <field name="marketplace_rent_requests_to_vendor"/>
                        </setting>
                        <setting string="Catalog Offers, Storefronts and Ratings" help="Sell existing products, show sellers on the product page, seller storefronts and customer ratings.">
                            <field name="marketplace_catalog_offers_enabled"/>
                            <div class="content-group" invisible="not marketplace_catalog_offers_enabled">
                                <div class="mt8"><label for="marketplace_vendor_rating_min_count"/> <field name="marketplace_vendor_rating_min_count"/></div>
                            </div>
                        </setting>
                        <setting string="Product Questions &amp; Answers" help="Let logged-in customers ask questions on the product page and sellers with an active offer on that product answer them from the vendor portal. Off: nothing is shown and the pages return 404.">
                            <field name="marketplace_product_questions_enabled"/>
                            <div class="mt-2" invisible="not marketplace_product_questions_enabled">
                                <field name="marketplace_product_questions_moderation"/>
                            </div>
                            <div class="mt-2" invisible="not marketplace_product_questions_enabled">
                                <label for="marketplace_product_questions_daily_limit" class="o_light_label"/>
                                <field name="marketplace_product_questions_daily_limit"/>
                            </div>
                        </setting>
                        <setting string="Vendor Return Response" help="Days the vendor has to answer a return request before it escalates to the marketplace.">
                            <field name="marketplace_return_vendor_sla_days"/>
                        </setting>
                        <setting string="Dispute SLA">
                            <field name="marketplace_dispute_sla_days"/>
                        </setting>
                        <setting string="Withhold a Returns Reserve" help="Hold back the vendor tier's reserve percentage from each earning until the return window closes. Off, the reserve is only recorded.">
                            <field name="marketplace_enforce_returns_reserve"/>
                        </setting>
                        <setting string="Flag High Cancellation Rates" help="Prepare a draft warning penalty when a vendor's monthly cancellation rate passes the threshold. Never applied automatically.">
                            <field name="marketplace_kpi_auto_warning"/>
                        </setting>
                        <setting string="Vendor Product Discounts" help="Let vendors discount their own offers (percentage or sale price, optional dates). Off keeps every price as it is; running discounts are not touched.">
                            <field name="marketplace_vendor_discounts_enabled"/>
                        </setting>
                        <setting string="Discount Without Approval (%)" help="A vendor discount above this percentage waits for a reviewer in Discounts to Review." invisible="not marketplace_vendor_discounts_enabled">
                            <field name="marketplace_max_vendor_discount_without_approval"/>
                        </setting>
                        <setting string="Ship-by SLA" help="Days after confirmation by which a vendor must ship. Orders past it are flagged Late, reviewers get an activity and the vendor an email (notification switch). A vendor tier can override the value.">
                            <field name="marketplace_ship_sla_days"/>
                        </setting>
                        <setting string="Flag High Late-Shipment Rates" help="Prepare a draft warning penalty when a vendor's monthly late-shipment rate passes the threshold. Never applied automatically.">
                            <field name="marketplace_late_shipment_auto_warning"/>
                        </setting>
                        <setting string="Late-Shipment Rate Threshold (%)" help="Monthly late-shipment rate above which a draft warning is prepared." invisible="not marketplace_late_shipment_auto_warning">
                            <field name="marketplace_late_shipment_rate_threshold"/>
                        </setting>
                        <setting string="Create Settlements Automatically" help="Open a draft settlement per vendor at the end of each period of their tier's payout frequency. Approval and payment stay manual.">
                            <field name="marketplace_auto_settlements"/>
                        </setting>
                        <setting string="Upgrade Vendor Tiers Automatically" help="Monthly, move vendors up to the highest tier whose seniority, sales and rating thresholds they meet. Never moves anyone down.">
                            <field name="marketplace_auto_tier_upgrade"/>
                        </setting>
                        <setting string="Cancellation Rate Threshold (%)" help="Monthly cancellation rate above which a draft warning is prepared." invisible="not marketplace_kpi_auto_warning">
                            <field name="marketplace_kpi_cancellation_threshold"/>
                        </setting>
                        <setting string="Vendors Without a Commission Plan" help="A vendor not covered by any commission plan pays nothing by default. Switch to the tier rate to deduct their vendor-tier percentage from each settlement instead.">
                            <field name="marketplace_no_plan_commission_mode"/>
                        </setting>
                        <setting string="Default Commission Rate (%)" help="Used for vendors with no tier rate of their own. Only applied when vendors without a plan are charged the tier rate.">
                            <field name="marketplace_default_commission_rate"/>
                        </setting>
                        <setting string="FBL Delivery Charge" invisible="not marketplace_fbl_enabled" help="FBL orders ship from the marketplace warehouse. Choose whether the delivery charge is paid to the vendor or kept by the marketplace.">
                            <field name="marketplace_fbl_delivery_income"/>
                        </setting>
                        <setting string="Split Delivery Between Vendors" help="Only for carriers other than the per-governorate marketplace one. Off, the whole charge goes to the first vendor of the checkout.">
                            <field name="marketplace_split_delivery_proportional"/>
                        </setting>
                        <setting string="Allow Cash on Delivery" help="Shows a Cash on Delivery option at checkout, alongside online payment.">
                            <field name="marketplace_cod_enabled"/>
                        </setting>
                        <setting string="COD Maximum Amount" invisible="not marketplace_cod_enabled" help="Cash on Delivery is hidden above this order total. 0 means no limit.">
                            <field name="marketplace_cod_max_amount"/>
                        </setting>
                        <setting string="COD Phone Verification" invisible="not marketplace_cod_enabled" help="Customers confirm a 6-digit code sent to their phone before a Cash on Delivery order is accepted.">
                            <field name="marketplace_cod_require_otp"/>
                        </setting>
                        <setting string="Block COD After Refusals" invisible="not marketplace_cod_enabled" help="Hide Cash on Delivery for customers who refused this many parcels at the door. 0 turns it off.">
                            <field name="marketplace_cod_refusal_block_count"/>
                        </setting>
                        <setting string="Vendor Bulk Import" help="Let vendors upload xlsx/csv files to create products, sell catalog products and update price, stock and discounts. Every row is validated first and only valid rows are applied after the vendor confirms.">
                            <field name="marketplace_vendor_bulk_import_enabled"/>
                        </setting>
                        <setting string="Import Rows per Cron Run" invisible="not marketplace_vendor_bulk_import_enabled" help="Rows applied per run of the 'process vendor imports' cron.">
                            <field name="marketplace_vendor_import_batch_size"/>
                        </setting>
                        <setting string="Import: Download Images from URLs" invisible="not marketplace_vendor_bulk_import_enabled" help="Off (default): image_url cells are ignored with a warning. On: the server downloads public http/https images (ports 80/443, no redirects, size limit).">
                            <field name="marketplace_vendor_import_allow_image_urls"/>
                        </setting>
                        <setting string="Vendor Write API" help="Let vendor owners create API keys (portal page /my/vendor/api) and manage offers, orders, returns and read finance through /api/v1/vendor with a bearer key. Documentation: /api/v1/openapi.json.">
                            <field name="marketplace_vendor_api_write_enabled"/>
                        </setting>
                        <setting string="API Calls per Minute" invisible="not marketplace_vendor_api_write_enabled" help="Per key. 0 = no limit.">
                            <field name="marketplace_vendor_api_rate_limit"/>
                        </setting>
                        <setting string="Shipping Carrier Framework" help="Let vendors create shipments and labels with the active shipping providers (Marketplace > Configuration > Shipping Providers) and let carriers report pickup, delivery and refusal through a signed webhook.">
                            <field name="marketplace_shipping_providers_enabled"/>
                        </setting>
                        <setting string="Shipping Webhook Rate Limits" invisible="not marketplace_shipping_providers_enabled" help="Carrier webhook calls per minute: per provider and source IP, and per provider overall. 0 = no limit. Behind a reverse proxy enable proxy_mode so the real source address is used.">
                            <field name="marketplace_shipping_webhook_rate_limit"/>
                            <field name="marketplace_shipping_webhook_provider_rate_limit"/>
                        </setting>
                        <setting string="Vendor Variants, Images and Specifications" help="Let vendors build variants from existing attributes (one offer per variant), add extra images and write specifications on products they own. Off keeps the single-variant product form.">
                            <field name="marketplace_vendor_variants_enabled"/>
                        </setting>
                        <setting string="Vendors May Create Attributes" invisible="not marketplace_vendor_variants_enabled" help="Allow vendors to add new attribute values and attributes. They are global: every vendor sees them.">
                            <field name="marketplace_allow_vendor_attributes"/>
                        </setting>
                        <setting string="Vendor Extra Images" invisible="not marketplace_vendor_variants_enabled" help="Extra images per product (0 = 8).">
                            <field name="marketplace_vendor_max_extra_images"/>
                        </setting>
                        <setting string="Vendor Image Max Size (MB)" help="Largest product image a vendor may upload from the portal. Non-image files are always refused.">
                            <field name="marketplace_vendor_image_max_mb"/>
                        </setting>
                        <setting string="COD Cash Journal" invisible="not marketplace_fbl_enabled" help="Where the cash collected on delivery is received for platform-delivered (FBL) orders. Empty, nothing is booked and a chatter note is left instead.">
                            <field name="marketplace_cod_cash_journal_id"/>
                        </setting>
                        <setting string="FBM Delivery Confirmation" help="Whether a vendor marking their own shipment delivered completes the order, or only reports it for the customer to confirm.">
                            <field name="marketplace_fbm_delivery_mode"/>
                        </setting>
                        <setting string="Auto-confirm Delivery After (Days)" help="Only used when the customer confirms deliveries. Zero waits for the customer forever." invisible="marketplace_fbm_delivery_mode != 'customer_confirm'">
                            <field name="marketplace_fbm_auto_confirm_days"/>
                        </setting>
                    </block>
                    <block title="Vendor Email Notifications">
                        <setting string="Orders" help="Emails about the vendor's orders.">
                            <div class="d-flex flex-column gap-2 mt-2">
                                <div class="d-flex align-items-center gap-2"><field name="marketplace_notify_vendor_order_confirmed"/><label for="marketplace_notify_vendor_order_confirmed" class="o_light_label mb-0"/></div>
                                <div class="d-flex align-items-center gap-2"><field name="marketplace_notify_vendor_order_cancelled_by_customer"/><label for="marketplace_notify_vendor_order_cancelled_by_customer" class="o_light_label mb-0"/></div>
                                <div class="d-flex align-items-center gap-2"><field name="marketplace_notify_vendor_order_late"/><label for="marketplace_notify_vendor_order_late" class="o_light_label mb-0"/></div>
                            </div>
                        </setting>
                        <setting string="Returns &amp; Disputes" help="Emails about returns and disputes on the vendor's orders.">
                            <div class="d-flex flex-column gap-2 mt-2">
                                <div class="d-flex align-items-center gap-2"><field name="marketplace_notify_vendor_return_requested"/><label for="marketplace_notify_vendor_return_requested" class="o_light_label mb-0"/></div>
                                <div class="d-flex align-items-center gap-2"><field name="marketplace_notify_vendor_return_escalated"/><label for="marketplace_notify_vendor_return_escalated" class="o_light_label mb-0"/></div>
                                <div class="d-flex align-items-center gap-2"><field name="marketplace_notify_vendor_return_decided"/><label for="marketplace_notify_vendor_return_decided" class="o_light_label mb-0"/></div>
                                <div class="d-flex align-items-center gap-2"><field name="marketplace_notify_vendor_dispute_opened"/><label for="marketplace_notify_vendor_dispute_opened" class="o_light_label mb-0"/></div>
                                <div class="d-flex align-items-center gap-2"><field name="marketplace_notify_vendor_dispute_escalated"/><label for="marketplace_notify_vendor_dispute_escalated" class="o_light_label mb-0"/></div>
                                <div class="d-flex align-items-center gap-2"><field name="marketplace_notify_vendor_dispute_resolved"/><label for="marketplace_notify_vendor_dispute_resolved" class="o_light_label mb-0"/></div>
                            </div>
                        </setting>
                        <setting string="Finance" help="Emails about settlements and payout account changes.">
                            <div class="d-flex flex-column gap-2 mt-2">
                                <div class="d-flex align-items-center gap-2"><field name="marketplace_notify_vendor_settlement_approved"/><label for="marketplace_notify_vendor_settlement_approved" class="o_light_label mb-0"/></div>
                                <div class="d-flex align-items-center gap-2"><field name="marketplace_notify_vendor_settlement_paid"/><label for="marketplace_notify_vendor_settlement_paid" class="o_light_label mb-0"/></div>
                                <div class="d-flex align-items-center gap-2"><field name="marketplace_notify_vendor_settlement_debt"/><label for="marketplace_notify_vendor_settlement_debt" class="o_light_label mb-0"/></div>
                                <div class="d-flex align-items-center gap-2"><field name="marketplace_notify_vendor_bank_change_approved"/><label for="marketplace_notify_vendor_bank_change_approved" class="o_light_label mb-0"/></div>
                                <div class="d-flex align-items-center gap-2"><field name="marketplace_notify_vendor_bank_change_rejected"/><label for="marketplace_notify_vendor_bank_change_rejected" class="o_light_label mb-0"/></div>
                            </div>
                        </setting>
                        <setting string="Catalog &amp; Application" help="Emails about offers, products and the vendor application.">
                            <div class="d-flex flex-column gap-2 mt-2">
                                <div class="d-flex align-items-center gap-2"><field name="marketplace_notify_vendor_offer_approved"/><label for="marketplace_notify_vendor_offer_approved" class="o_light_label mb-0"/></div>
                                <div class="d-flex align-items-center gap-2"><field name="marketplace_notify_vendor_offer_rejected"/><label for="marketplace_notify_vendor_offer_rejected" class="o_light_label mb-0"/></div>
                                <div class="d-flex align-items-center gap-2"><field name="marketplace_notify_vendor_product_approved"/><label for="marketplace_notify_vendor_product_approved" class="o_light_label mb-0"/></div>
                                <div class="d-flex align-items-center gap-2"><field name="marketplace_notify_vendor_product_rejected"/><label for="marketplace_notify_vendor_product_rejected" class="o_light_label mb-0"/></div>
                                <div class="d-flex align-items-center gap-2"><field name="marketplace_notify_vendor_application_approved"/><label for="marketplace_notify_vendor_application_approved" class="o_light_label mb-0"/></div>
                                <div class="d-flex align-items-center gap-2"><field name="marketplace_notify_vendor_application_rejected"/><label for="marketplace_notify_vendor_application_rejected" class="o_light_label mb-0"/></div>
                            </div>
                        </setting>
                        <setting string="Penalties" help="Emails about penalties applied to or lifted from the vendor.">
                            <div class="d-flex flex-column gap-2 mt-2">
                                <div class="d-flex align-items-center gap-2"><field name="marketplace_notify_vendor_penalty_applied"/><label for="marketplace_notify_vendor_penalty_applied" class="o_light_label mb-0"/></div>
                                <div class="d-flex align-items-center gap-2"><field name="marketplace_notify_vendor_penalty_lifted"/><label for="marketplace_notify_vendor_penalty_lifted" class="o_light_label mb-0"/></div>
                            </div>
                        </setting>
                        <setting string="Product Questions" help="Email when a customer asks a question on the vendor's product.">
                            <div class="d-flex flex-column gap-2 mt-2">
                                <div class="d-flex align-items-center gap-2"><field name="marketplace_notify_vendor_question_asked"/><label for="marketplace_notify_vendor_question_asked" class="o_light_label mb-0"/></div>
                            </div>
                        </setting>
                    </block>
                    <block title="Customer Email Notifications">
                        <setting string="Orders" help="Emails about the customer's orders.">
                            <div class="d-flex flex-column gap-2 mt-2">
                                <div class="d-flex align-items-center gap-2"><field name="marketplace_notify_customer_order_shipped"/><label for="marketplace_notify_customer_order_shipped" class="o_light_label mb-0"/></div>
                                <div class="d-flex align-items-center gap-2"><field name="marketplace_notify_customer_order_delivered"/><label for="marketplace_notify_customer_order_delivered" class="o_light_label mb-0"/></div>
                                <div class="d-flex align-items-center gap-2"><field name="marketplace_notify_customer_order_cancelled"/><label for="marketplace_notify_customer_order_cancelled" class="o_light_label mb-0"/></div>
                                <div class="d-flex align-items-center gap-2"><field name="marketplace_notify_customer_order_cancelled_by_customer"/><label for="marketplace_notify_customer_order_cancelled_by_customer" class="o_light_label mb-0"/></div>
                            </div>
                        </setting>
                        <setting string="Returns" help="Emails about the customer's return requests.">
                            <div class="d-flex flex-column gap-2 mt-2">
                                <div class="d-flex align-items-center gap-2"><field name="marketplace_notify_customer_return_approved"/><label for="marketplace_notify_customer_return_approved" class="o_light_label mb-0"/></div>
                                <div class="d-flex align-items-center gap-2"><field name="marketplace_notify_customer_return_rejected"/><label for="marketplace_notify_customer_return_rejected" class="o_light_label mb-0"/></div>
                                <div class="d-flex align-items-center gap-2"><field name="marketplace_notify_customer_return_refunded"/><label for="marketplace_notify_customer_return_refunded" class="o_light_label mb-0"/></div>
                            </div>
                        </setting>
                        <setting string="Product Questions" help="Email when a seller answers the customer's question.">
                            <div class="d-flex flex-column gap-2 mt-2">
                                <div class="d-flex align-items-center gap-2"><field name="marketplace_notify_customer_question_answered"/><label for="marketplace_notify_customer_question_answered" class="o_light_label mb-0"/></div>
                            </div>
                        </setting>
                    </block>
                    <block title="Marketplace Ledger Accounts" help="Real journal entries are posted for the escrow money flow. Configure the accounts and journal below.">
                        <setting string="Escrow (Vendor Holdings)">
                            <field name="marketplace_escrow_account_id"/>
                        </setting>
                        <setting string="Commission Income">
                            <field name="marketplace_commission_income_account_id"/>
                        </setting>
                        <setting string="Fulfilment Fee Income">
                            <field name="marketplace_fee_income_account_id"/>
                        </setting>
                        <setting string="Vendor Payable">
                            <field name="marketplace_vendor_payable_account_id"/>
                        </setting>
                        <setting string="Commission Invoicing" help="Journal keeps today's entries. Invoice issues a tax invoice to the vendor when a settlement is approved, netted against the vendor payable. Ask your accountant to validate the account mapping before enabling it.">
                            <field name="marketplace_commission_invoicing"/>
                            <div class="content-group" invisible="marketplace_commission_invoicing != 'invoice'">
                                <div class="mt8"><label for="marketplace_commission_tax_ids"/> <field name="marketplace_commission_tax_ids" widget="many2many_tags"/></div>
                            </div>
                        </setting>
                        <setting string="Marketplace Journal">
                            <field name="marketplace_journal_id"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
