<odoo>
    <template id="cart_marketplace_price_changed" inherit_id="website_sale.cart">
        <xpath expr="//h3[normalize-space(text())='Order overview']" position="before">
            <div t-if="request.params.get('lm_price_changed')" class="alert alert-warning" role="alert">
                Prices of some items changed, please review your cart
            </div>
        </xpath>
    </template>
    <template id="checkout_cash_on_delivery" inherit_id="website_sale.payment">
        <xpath expr="//div[@id='payment_method']" position="after">
            <div t-if="marketplace_cod_message and not errors" class="mt-3 alert alert-warning small mb-0" role="alert">
                <i class="fa fa-info-circle"/> <t t-esc="marketplace_cod_message"/>
            </div>
            <div t-if="marketplace_cod_enabled and not errors" class="mt-3" id="lm_cod_box">
                <div t-if="marketplace_cod_status == 'sent'" class="alert alert-info small">A verification code was sent. It is valid for 5 minutes.</div>
                <div t-if="marketplace_cod_status == 'wrong'" class="alert alert-danger small">The code is not correct.</div>
                <div t-if="marketplace_cod_status == 'error' and marketplace_cod_error" class="alert alert-danger small" t-esc="marketplace_cod_error"/>
                <t t-if="marketplace_cod_otp and not marketplace_cod_verified">
                    <form action="/shop/payment/cod/otp/send" method="post" class="row g-2 align-items-end mb-2">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="col-12 col-sm-7">
                            <label class="form-label small mb-1" for="lm_cod_phone">Mobile number for Cash on Delivery</label>
                            <input id="lm_cod_phone" class="form-control" type="tel" name="phone" required="required" dir="ltr" t-att-value="marketplace_cod_phone"/>
                        </div>
                        <div class="col-12 col-sm-5">
                            <button type="submit" class="btn btn-outline-primary w-100">Send code</button>
                        </div>
                    </form>
                    <form action="/shop/payment/cod/otp/verify" method="post" class="row g-2 align-items-end">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="phone" t-att-value="marketplace_cod_phone"/>
                        <div class="col-12 col-sm-7">
                            <label class="form-label small mb-1" for="lm_cod_code">Verification code</label>
                            <input id="lm_cod_code" class="form-control" type="text" name="code" inputmode="numeric" maxlength="6" autocomplete="one-time-code" required="required" dir="ltr"/>
                        </div>
                        <div class="col-12 col-sm-5">
                            <button type="submit" class="btn btn-primary w-100">Verify</button>
                        </div>
                    </form>
                </t>
                <div t-if="marketplace_cod_otp and marketplace_cod_verified" class="small text-success mb-2">
                    <i class="fa fa-check-circle"/> Phone number verified.
                </div>
                <form t-if="not marketplace_cod_otp or marketplace_cod_verified" action="/shop/payment/cod" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <button type="submit" class="btn btn-secondary">
                        <i class="fa fa-money"/> Pay Cash on Delivery
                    </button>
                </form>
            </div>
        </xpath>
    </template>
    <!-- A1: who charges which part of the delivery (cart, checkout and payment steps). -->
    <template id="cart_total_delivery_breakdown" inherit_id="website_sale.total">
        <xpath expr="//tr[@id='order_delivery']" position="after">
            <t t-set="lm_breakdown" t-value="website_sale_order._leaders_delivery_breakdown() if website_sale_order and website_sale_order.carrier_id else []"/>
            <tr t-foreach="lm_breakdown" t-as="lm_part" t-if="len(lm_breakdown) &gt; 0" class="lm-delivery-breakdown">
                <td class="ps-3 pt-0 pb-2 border-0 text-muted small" colspan="2"><t t-out="lm_part[0]"/></td>
                <td class="text-end pe-0 pt-0 pb-2 border-0 text-muted small">
                    <span t-if="lm_part[1]" t-out="lm_part[1]" style="white-space: nowrap;"
                          t-options="{'widget': 'monetary', 'display_currency': website_sale_order.currency_id}"/>
                    <span t-else="">Free</span>
                </td>
            </tr>
            <t t-set="lm_estimates" t-value="website_sale_order._leaders_delivery_estimates() if website_sale_order and website_sale_order.carrier_id else []"/>
            <tr t-foreach="lm_estimates" t-as="lm_est" t-if="len(lm_estimates) &gt; 0" class="lm-delivery-estimate">
                <td class="ps-3 pt-0 pb-2 border-0 text-muted small" colspan="3"><i class="fa fa-clock-o" aria-hidden="true"/> <t t-out="lm_est[0]"/>: <t t-out="lm_est[1]"/></td>
            </tr>
        </xpath>
    </template>
    <template id="confirmation_delivery_breakdown" inherit_id="website_sale.confirmation">
        <xpath expr="//t[@t-call='website_sale.payment_confirmation_status']" position="after">
            <t t-set="lm_breakdown" t-value="order._leaders_delivery_breakdown()"/>
            <div t-if="lm_breakdown" class="lm-delivery-breakdown mt-3 text-muted small">
                <t t-foreach="lm_breakdown" t-as="lm_part">
                    <span class="d-inline-block me-3">
                        <t t-out="lm_part[0]"/>:
                        <span t-if="lm_part[1]" t-out="lm_part[1]" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                        <span t-else="">Free</span>
                    </span>
                </t>
            </div>
            <t t-set="lm_estimates" t-value="order._leaders_delivery_estimates()"/>
            <div t-if="lm_estimates" class="lm-delivery-estimate mt-2 text-muted small">
                <div t-foreach="lm_estimates" t-as="lm_est"><i class="fa fa-clock-o" aria-hidden="true"/> <t t-out="lm_est[0]"/>: <t t-out="lm_est[1]"/></div>
            </div>
        </xpath>
    </template>
    <template id="report_saleorder_delivery_breakdown" inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[@id='total']" position="after">
            <t t-set="lm_breakdown" t-value="doc._leaders_delivery_breakdown()"/>
            <p t-if="lm_breakdown" class="lm-delivery-breakdown text-muted small">
                <t t-foreach="lm_breakdown" t-as="lm_part">
                    <t t-out="lm_part[0]"/>:
                    <span t-if="lm_part[1]" t-out="lm_part[1]" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                    <span t-else="">Free</span>
                    <t t-if="not lm_part_last"> · </t>
                </t>
            </p>
        </xpath>
    </template>
    <!-- B1: vendor discount badge. The struck-through original price comes from the
         core price templates (has_discounted_price / base_price / line.discount). -->
    <template id="product_price_vendor_discount_badge" inherit_id="website_sale.product_price">
        <xpath expr="//span[@itemprop='listPrice']" position="after">
            <span t-if="combination_info.get('leaders_discount_percent')"
                  class="badge text-bg-danger ms-1 align-middle lm-discount-badge"><bdi dir="ltr">-<t t-out="combination_info['leaders_discount_percent']"/>%</bdi></span>
        </xpath>
    </template>
    <template id="products_item_vendor_discount_badge" inherit_id="website_sale.products_item">
        <xpath expr="//span[@itemprop='price']" position="before">
            <span t-if="template_price_vals.get('leaders_discount_percent')"
                  class="badge text-bg-danger ms-1 lm-discount-badge"><bdi dir="ltr">-<t t-out="template_price_vals['leaders_discount_percent']"/>%</bdi></span>
        </xpath>
    </template>
    <template id="cart_lines_vendor_discount_badge" inherit_id="website_sale.cart_lines">
        <xpath expr="//div[@name='website_sale_cart_line_price']" position="inside">
            <span t-if="line.marketplace_offer_id and line.discount &gt; 0"
                  class="badge text-bg-danger ms-1 lm-discount-badge"><bdi dir="ltr">-<t t-out="int(line.discount)"/>%</bdi></span>
        </xpath>
    </template>
</odoo>
