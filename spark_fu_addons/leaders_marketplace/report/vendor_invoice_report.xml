<odoo>
    <record id="action_report_vendor_invoice" model="ir.actions.report">
        <field name="name">Vendor Invoice</field>
        <field name="model">leaders.vendor.invoice</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">leaders_marketplace.report_vendor_invoice</field>
        <field name="report_file">leaders_marketplace.report_vendor_invoice</field>
        <field name="print_report_name">object._get_report_base_filename()</field>
        <field name="binding_model_id" ref="model_leaders_vendor_invoice"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_vendor_invoice_document">
        <!-- basic_layout: no company header/footer, the invoice is issued by the vendor. -->
        <t t-call="web.basic_layout">
            <div class="page">
                <div class="row mb-4">
                    <div class="col-7">
                        <img t-if="o.vendor_id.image_128" t-att-src="image_data_uri(o.vendor_id.image_128)" style="max-height: 60px;" alt="Vendor"/>
                        <h3 class="mb-1" t-esc="o.vendor_id.vendor_store_name or o.vendor_id.name"/>
                        <div t-field="o.vendor_id" t-options="{'widget': 'contact', 'fields': ['address', 'phone', 'email', 'vat'], 'no_marker': True}"/>
                    </div>
                    <div class="col-5 text-end">
                        <h2 class="mb-1" t-if="o.move_type == 'out_refund'">Credit Note</h2>
                        <h2 class="mb-1" t-else="">Invoice</h2>
                        <div t-if="o.reversed_invoice_id">Reversal of: <span t-field="o.reversed_invoice_id.name"/></div>
                        <div><strong t-field="o.name"/></div>
                        <div>Date: <span t-field="o.invoice_date"/></div>
                        <div>Order: <span t-field="o.vendor_order_id.name"/></div>
                        <div t-if="o.state == 'cancelled'" class="text-danger fw-bold">CANCELLED</div>
                    </div>
                </div>
                <div class="row mb-4">
                    <div class="col-6">
                        <strong>Bill To</strong>
                        <div t-field="o.partner_id" t-options="{'widget': 'contact', 'fields': ['name', 'address', 'vat'], 'no_marker': True}"/>
                    </div>
                    <div class="col-6" t-if="o.vendor_order_id.partner_shipping_id and o.vendor_order_id.partner_shipping_id != o.partner_id">
                        <strong>Ship To</strong>
                        <div t-field="o.vendor_order_id.partner_shipping_id" t-options="{'widget': 'contact', 'fields': ['name', 'address'], 'no_marker': True}"/>
                    </div>
                </div>
                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th class="text-start">Description</th>
                            <th class="text-end">Quantity</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Disc.%</th>
                            <th class="text-end">Taxes</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.line_ids" t-as="line">
                            <td><span t-field="line.name"/></td>
                            <td class="text-end"><span t-field="line.quantity"/> <span t-field="line.product_uom"/></td>
                            <td class="text-end"><span t-field="line.price_unit"/></td>
                            <td class="text-end"><span t-field="line.discount"/></td>
                            <td class="text-end"><span t-esc="', '.join(line.tax_ids.mapped('name'))"/></td>
                            <td class="text-end"><span t-field="line.price_subtotal"/></td>
                        </tr>
                    </tbody>
                </table>
                <div class="row justify-content-end">
                    <div class="col-5">
                        <table class="table table-sm">
                            <tr><td>Untaxed Amount</td><td class="text-end"><span t-field="o.amount_untaxed"/></td></tr>
                            <tr><td>Taxes</td><td class="text-end"><span t-field="o.amount_tax"/></td></tr>
                            <tr class="border-black fw-bold"><td>Total</td><td class="text-end"><span t-field="o.amount_total"/></td></tr>
                        </table>
                    </div>
                </div>
                <p t-if="o.payment_state == 'paid'" class="mt-3"><strong>Paid.</strong></p>
                <p class="text-muted small mt-4">
                    This invoice is issued by the vendor named above.
                    Payment was collected by <span t-field="o.env.company.name"/> on the vendor's behalf through the marketplace.
                </p>
            </div>
        </t>
    </template>

    <template id="report_vendor_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="leaders_marketplace.report_vendor_invoice_document" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>
