<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Default reasons a customer can pick when cancelling an order; edit them under
         Marketplace > Configuration > Cancellation Reasons. -->
    <record id="cancel_reason_changed_mind" model="leaders.cancel.reason">
        <field name="name">I changed my mind</field>
        <field name="sequence">10</field>
        <field name="applies_to">customer</field>
    </record>
    <record id="cancel_reason_ordered_by_mistake" model="leaders.cancel.reason">
        <field name="name">I ordered by mistake</field>
        <field name="sequence">20</field>
        <field name="applies_to">customer</field>
    </record>
    <record id="cancel_reason_found_cheaper" model="leaders.cancel.reason">
        <field name="name">I found a better price elsewhere</field>
        <field name="sequence">30</field>
        <field name="applies_to">customer</field>
    </record>
    <record id="cancel_reason_delivery_too_long" model="leaders.cancel.reason">
        <field name="name">Delivery takes too long</field>
        <field name="sequence">40</field>
        <field name="applies_to">customer</field>
    </record>
    <record id="cancel_reason_wrong_details" model="leaders.cancel.reason">
        <field name="name">Wrong address or order details</field>
        <field name="sequence">50</field>
        <field name="applies_to">customer</field>
    </record>
    <record id="cancel_reason_other" model="leaders.cancel.reason">
        <field name="name">Other</field>
        <field name="sequence">100</field>
        <field name="applies_to">both</field>
    </record>
</odoo>
