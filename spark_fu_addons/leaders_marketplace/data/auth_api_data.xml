<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- default allowed origins; never overwrites a value the admin already set -->
    <function model="leaders.auth.rate" name="set_default_cors_origins"/>

    <!-- a new storefront account confirms its email with a code (project guide: OTP at sign-up); "0" turns it off -->
    <record id="param_auth_register_otp" model="ir.config_parameter">
        <field name="key">leaders_marketplace.auth_register_otp</field>
        <field name="value">1</field>
    </record>
    <!-- leaders_marketplace.auth_master_code: a shared code every account accepts next to the emailed one, for
         testing only. Not set by default; add the parameter (6 digits) to switch it on, delete it to switch it off. -->
    <record id="cron_auth_api_purge" model="ir.cron">
        <field name="name">Auth API: Purge Tokens, Codes and Counters</field>
        <field name="model_id" ref="model_leaders_auth_refresh_token"/>
        <field name="state">code</field>
        <field name="code">model.cron_purge(); env['leaders.auth.reset.code'].cron_purge(); env['leaders.auth.rate'].cron_purge()</field>
        <field name="interval_number">1</field><field name="interval_type">days</field><field name="active">True</field>
    </record>
</odoo>
