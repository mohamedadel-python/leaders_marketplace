<odoo noupdate="1">
    <record id="vendor_tier_bronze" model="leaders.vendor.tier">
        <field name="name">Bronze</field>
        <field name="code">bronze</field>
        <field name="sequence">10</field>
        <field name="commission_rate">15</field>
        <field name="product_limit">50</field>
        <field name="payout_frequency">monthly</field>
        <field name="escrow_release_policy">deliver_plus_days</field>
        <field name="escrow_release_days">15</field>
        <field name="reserve_percent">10</field>
        <field name="return_policy">reserve_first</field>
    </record>
    <record id="vendor_tier_silver" model="leaders.vendor.tier">
        <field name="name">Silver</field>
        <field name="code">silver</field>
        <field name="sequence">20</field>
        <field name="commission_rate">12</field>
        <field name="product_limit">200</field>
        <field name="payout_frequency">weekly</field>
        <field name="escrow_release_policy">deliver_plus_days</field>
        <field name="escrow_release_days">7</field>
        <field name="reserve_percent">5</field>
        <field name="return_policy">reserve_first</field>
    </record>
    <record id="vendor_tier_gold" model="leaders.vendor.tier">
        <field name="name">Gold</field>
        <field name="code">gold</field>
        <field name="sequence">30</field>
        <field name="commission_rate">10</field>
        <field name="product_limit">500</field>
        <field name="payout_frequency">weekly</field>
        <field name="escrow_release_policy">on_deliver</field>
        <field name="escrow_release_days">0</field>
        <field name="reserve_percent">3</field>
        <field name="return_policy">reserve_first</field>
    </record>
    <record id="vendor_tier_platinum" model="leaders.vendor.tier">
        <field name="name">Platinum</field>
        <field name="code">platinum</field>
        <field name="sequence">40</field>
        <field name="commission_rate">8</field>
        <field name="product_limit">0</field>
        <field name="payout_frequency">daily</field>
        <field name="escrow_release_policy">on_ship</field>
        <field name="escrow_release_days">0</field>
        <field name="reserve_percent">0</field>
        <field name="return_policy">deduct_next</field>
    </record>
    <record id="buybox_config_default" model="leaders.buybox.config">
        <field name="name">Default Buy Box Policy</field>
        <field name="price_weight">50</field>
        <field name="rating_weight">20</field>
        <field name="availability_weight">15</field>
        <field name="shipping_speed_weight">10</field>
        <field name="vendor_tier_weight">5</field>
        <field name="require_stock">True</field>
    </record>
</odoo>
