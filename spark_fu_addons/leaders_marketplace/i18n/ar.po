#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_auth_reset_code
msgid ""
"<div style=\"margin: 0px; padding: 0px; background-color: #e8edf5;\">\n"
"<div style=\"display: none; max-height: 0px; overflow: hidden; opacity: 0; font-size: 1px; line-height: 1px; color: #e8edf5;\">رمز استعادة كلمة المرور: <strong t-out=\"ctx.get('reset_code') or ''\"/> · Your password reset code</div>\n"
"<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#e8edf5\" style=\"background-color: #e8edf5; padding: 40px 12px; font-family: Cairo, 'Segoe UI', Tahoma, Arial, sans-serif;\">\n"
"<tr><td align=\"center\">\n"
"<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width: 600px; background-color: #ffffff; border-radius: 22px; overflow: hidden; box-shadow: 0px 14px 40px rgba(3, 28, 110, 0.16);\">\n"
"    <!-- hero -->\n"
"    <tr><td align=\"center\" bgcolor=\"#031c6e\" style=\"background-color: #031c6e; background-image: radial-gradient(circle at 85% 15%, rgba(99, 153, 208, 0.45) 0%, rgba(99, 153, 208, 0) 45%), radial-gradient(circle at 10% 110%, rgba(62, 83, 154, 0.9) 0%, rgba(62, 83, 154, 0) 55%), linear-gradient(160deg, #031c6e 0%, #0b2a7f 60%, #1d3b8f 100%); padding: 38px 28px 44px 28px;\">\n"
"        <a href=\"https://spark-fu.com\" target=\"_blank\" style=\"text-decoration: none;\"><img t-att-src=\"object.get_base_url() + '/leaders_marketplace/static/src/img/email_logo.png'\" width=\"210\" alt=\"Spark Fu\" style=\"display: block; width: 210px; max-width: 70%; height: auto; border: 0px;\"/></a>\n"
"        <div style=\"height: 1px; width: 64px; background-color: rgba(255, 255, 255, 0.25); margin: 26px auto 22px auto; line-height: 1px; font-size: 0px;\">&nbsp;</div>\n"
"        <p dir=\"rtl\" style=\"margin: 0px; font-size: 26px; font-weight: 800; color: #ffffff; line-height: 1.4;\">استعادة كلمة المرور</p>\n"
"        <p style=\"margin: 6px 0px 0px 0px; font-size: 14px; color: #a9c8ea; letter-spacing: 0.5px;\">Reset your password</p>\n"
"    </td></tr>\n"
"    <!-- greeting -->\n"
"    <tr><td dir=\"rtl\" align=\"center\" style=\"padding: 36px 36px 0px 36px; text-align: center;\">\n"
"        <p style=\"margin: 0px 0px 6px 0px; font-size: 17px; color: #1f2326;\">مرحبًا <strong t-out=\"object.name or ''\" style=\"color: #031c6e;\"/> 👋</p>\n"
"        <p style=\"margin: 0px; font-size: 15px; line-height: 1.9; color: #4b5563;\">استلمنا طلبًا لاستعادة كلمة المرور الخاصة بحسابك. أدخل الرمز التالي لتعيين كلمة مرور جديدة.</p>\n"
"    </td></tr>\n"
"    <!-- code tiles -->\n"
"    <tr><td align=\"center\" style=\"padding: 28px 20px 6px 20px;\">\n"
"        <table role=\"presentation\" dir=\"ltr\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr>\n"
"            <t t-foreach=\"list(ctx.get('reset_code') or '')\" t-as=\"digit\">\n"
"                <td style=\"padding: 0px 4px;\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr>\n"
"                    <td align=\"center\" valign=\"middle\" width=\"50\" height=\"62\" bgcolor=\"#f3f7fd\" style=\"width: 50px; height: 62px; background-color: #f3f7fd; border: 1px solid #cddcf0; border-bottom: 3px solid #3e539a; border-radius: 12px; font-family: 'Segoe UI', Arial, sans-serif; font-size: 32px; font-weight: 800; color: #031c6e; text-align: center;\"><t t-out=\"digit\"/></td>\n"
"                </tr></table></td>\n"
"            </t>\n"
"        </tr></table>\n"
"    </td></tr>\n"
"    <tr><td align=\"center\" style=\"padding: 16px 28px 0px 28px;\">\n"
