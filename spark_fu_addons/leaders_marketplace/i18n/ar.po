#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_item_request_received
msgid ""
"<div style=\"margin: 0px; padding: 0px; background-color: #eef2f7;\">\n"
"<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#eef2f7\" style=\"background-color: #eef2f7; padding: 32px 12px; font-family: Cairo, 'Segoe UI', Tahoma, Arial, sans-serif;\">\n"
"<tr><td align=\"center\">\n"
"<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width: 560px; background-color: #ffffff; border-radius: 16px; overflow: hidden;\">\n"
"    <tr><td align=\"center\" bgcolor=\"#031c6e\" style=\"background-color: #031c6e; padding: 28px 24px;\">\n"
"        <img t-att-src=\"object.get_base_url() + '/leaders_marketplace/static/src/img/email_logo.png'\" width=\"190\" alt=\"Spark Fu\" style=\"display: block; width: 190px; height: auto; border: 0px;\"/>\n"
"    </td></tr>\n"
"    <t t-if=\"object.request_locale == 'ar'\">\n"
"        <tr><td dir=\"rtl\" style=\"padding: 30px 32px 6px 32px; text-align: right; color: #1f2326;\">\n"
"            <p style=\"margin: 0px 0px 10px 0px; font-size: 21px; font-weight: 800; color: #031c6e;\">استلمنا طلبك</p>\n"
"            <p style=\"margin: 0px; font-size: 15px; line-height: 1.9;\">مرحبًا <strong t-out=\"object.contact_name or ''\"/>،<br/>شكرًا لتواصلك مع Spark Fu. استلمنا طلبك لـ <strong t-out=\"object.title\"/>، وسيتواصل معك فريق المبيعات قريبًا.</p>\n"
"        </td></tr>\n"
"        <tr><td align=\"center\" style=\"padding: 20px 32px;\">\n"
"            <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td bgcolor=\"#f3f7fd\" style=\"background-color: #f3f7fd; border: 1px solid #cddcf0; border-radius: 12px; padding: 14px 26px; text-align: center;\">\n"
"                <span style=\"display: block; font-size: 12px; color: #6b7280;\">رقم الطلب</span>\n"
"                <strong dir=\"ltr\" style=\"font-size: 24px; color: #031c6e; letter-spacing: 2px;\" t-out=\"object.name\"/>\n"
"            </td></tr></table>\n"
"        </td></tr>\n"
"        <tr><td dir=\"rtl\" style=\"padding: 0px 32px 28px 32px; text-align: right; font-size: 13px; color: #6b7280;\">احتفظ برقم الطلب للمتابعة.</td></tr>\n"
"    </t>\n"
"    <t t-else=\"\">\n"
"        <tr><td dir=\"ltr\" style=\"padding: 30px 32px 6px 32px; text-align: left; color: #1f2326;\">\n"
"            <p style=\"margin: 0px 0px 10px 0px; font-size: 21px; font-weight: 800; color: #031c6e;\">We received your request</p>\n"
"            <p style=\"margin: 0px; font-size: 15px; line-height: 1.8;\">Hello <strong t-out=\"object.contact_name or ''\"/>,<br/>Thank you for contacting Spark Fu. We received your request for <strong t-out=\"object.title\"/>, and our sales team will contact you soon.</p>\n"
"        </td></tr>\n"
"        <tr><td align=\"center\" style=\"padding: 20px 32px;\">\n"
"            <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td bgcolor=\"#f3f7fd\" style=\"background-color: #f3f7fd; border: 1px solid #cddcf0; border-radius: 12px; padding: 14px 26px; text-align: center;\">\n"
"                <span style=\"display: block; font-size: 12px; color: #6b7280;\">Request reference</span>\n"
"                <strong style=\"font-size: 24px; color: #031c6e; letter-spacing: 2px;\" t-out=\"object.name\"/>\n"
"            </td></tr></table>\n"
"        </td></tr>\n"
"        <tr><td style=\"padding: 0px 32px 28px 32px; text-align: left; font-size: 13px; color: #6b7280;\">Keep this reference to follow up on your request.</td></tr>\n"
"    </t>\n"
