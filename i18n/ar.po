"</div>\n"
"            "

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_customer_return_approved
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>Your return <strong t-out=\"object.name\"/> for order <t t-out=\"object.vendor_order_id.name\"/> was approved. Please send the goods back as instructed by the seller.</p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/marketplace/orders/{{ object.vendor_order_id.id }}\">Follow your order</a></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>تمت الموافقة على مرتجعك <strong t-out=\"object.name\"/> للطلب <t t-out=\"object.vendor_order_id.name\"/>. يرجى إعادة البضاعة وفق تعليمات البائع.</p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/marketplace/orders/{{ object.vendor_order_id.id }}\">تابع طلبك</a></p>\n"
"</div>\n"
"            "

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_customer_return_rejected
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>Your return <strong t-out=\"object.name\"/> for order <t t-out=\"object.vendor_order_id.name\"/> was not accepted.</p>\n"
"<p t-if=\"object.vendor_note or object.decision_note\">Reason: <t t-out=\"object.decision_note or object.vendor_note\"/></p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/marketplace/orders/{{ object.vendor_order_id.id }}\">Follow your order</a></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
