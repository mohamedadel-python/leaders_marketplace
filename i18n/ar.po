#. module: leaders_marketplace
#: model_terms:ir.ui.view,arch_db:leaders_marketplace.portal_vendor_api
msgid ""
"/api/v1/vendor/offers/42\"\n"
"\n"
"# ship an order\n"
"curl -X POST -H \"Authorization: Bearer YOUR_KEY\" -H \"Content-Type: application/json\" \\\n"
"     -d '{\"tracking_ref\": \"TRK123\"}' \""
msgstr ""
"/api/v1/vendor/offers/42\"\n"
"\n"
"# شحن طلب\n"
"curl -X POST -H \"Authorization: Bearer YOUR_KEY\" -H \"Content-Type: application/json\" \\\n"
"     -d '{\"tracking_ref\": \"TRK123\"}' \""

#. module: leaders_marketplace
#: model_terms:ir.ui.view,arch_db:leaders_marketplace.portal_vendor_api
msgid ""
"/api/v1/vendor/offers?limit=20\"\n"
"\n"
"# change a price and set a 15% discount (write key; Idempotency-Key makes retries safe)\n"
"curl -X PATCH -H \"Authorization: Bearer YOUR_KEY\" -H \"Idempotency-Key: 4d1c-0001\" \\\n"
"     -H \"Content-Type: application/json\" \\\n"
"     -d '{\"price\": 120.0, \"discount\": {\"type\": \"percent\", \"percent\": 15}}' \\\n"
"     \""
msgstr ""
"/api/v1/vendor/offers?limit=20\"\n"
"\n"
"# تغيير السعر وتطبيق خصم 15% (مفتاح كتابة؛ Idempotency-Key يجعل إعادة المحاولة آمنة)\n"
"curl -X PATCH -H \"Authorization: Bearer YOUR_KEY\" -H \"Idempotency-Key: 4d1c-0001\" \\\n"
"     -H \"Content-Type: application/json\" \\\n"
"     -d '{\"price\": 120.0, \"discount\": {\"type\": \"percent\", \"percent\": 15}}' \\\n"
"     \""

