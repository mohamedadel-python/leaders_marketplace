#: code:addons/leaders_marketplace/models/settlement.py:0
msgid ""
"%(vendor)s has a payout account change waiting for review. Approve or reject"
" it before paying %(name)s."
msgstr ""
"لدى %(vendor)s طلب تغيير لحساب صرف المستحقات قيد المراجعة. اعتمده أو ارفضه "
"قبل الدفع إلى %(name)s."

#. module: leaders_marketplace
#. odoo-python
#: code:addons/leaders_marketplace/models/commission.py:0
msgid ""
"%(vendor)s is already covered by another active commission plan (%(plan)s) "
"for an overlapping period. A vendor can only be in one commission plan at a "
"time."
msgstr ""
"%(vendor)s مشمول بالفعل بخطة عمولة نشطة أخرى (%(plan)s) لفترة متداخلة. لا "
"يمكن أن يكون البائع إلا في خطة عمولة واحدة في الوقت نفسه."

#. module: leaders_marketplace
