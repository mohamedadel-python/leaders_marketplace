"<p t-if=\"object.vendor_note or object.decision_note\">السبب: <t t-out=\"object.decision_note or object.vendor_note\"/></p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/marketplace/orders/{{ object.vendor_order_id.id }}\">تابع طلبك</a></p>\n"
"</div>\n"
"            "

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_customer_return_refunded
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
