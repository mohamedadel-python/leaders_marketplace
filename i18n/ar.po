#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_vendor_application_submitted
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"    <p>Hello <t t-out=\"object.owner_name or ''\"/>,</p>\n"
"    <p>We received your application to sell on our marketplace. Your reference is <strong t-out=\"object.name\"/>.</p>\n"
"    <p>You can follow its progress, see what is still missing and re-upload documents here:</p>\n"
"    <p><a t-attf-href=\"{{ object.get_base_url() }}/vendor/apply/status/{{ object.access_token }}\">Application status</a></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"    <p>مرحباً <t t-out=\"object.owner_name or ''\"/>,</p>\n"
"    <p>استلمنا طلب انضمامك للبيع في السوق الخاص بنا. الرقم المرجعي لطلبك هو <strong t-out=\"object.name\"/>.</p>\n"
"    <p>يمكنك متابعة حالة الطلب ومعرفة ما ينقصه وإعادة رفع المستندات من هنا:</p>\n"
"    <p><a t-attf-href=\"{{ object.get_base_url() }}/vendor/apply/status/{{ object.access_token }}\">حالة الطلب</a></p>\n"
"</div>\n"
"            "

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_marketplace_order_confirmation
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"    <p>Hello <t t-out=\"object.partner_id.name or ''\"/>,</p>\n"
"    <p>Thank you for your order <strong t-out=\"object.name\"/>. It has been split into the following orders, each prepared by its seller:</p>\n"
"    <table style=\"width: 100%; border-collapse: collapse;\">\n"
"        <thead>\n"
"            <tr>\n"
"                <th style=\"text-align: left;\">Order</th>\n"
"                <th style=\"text-align: left;\">Seller</th>\n"
"                <th style=\"text-align: left;\">Payment</th>\n"
"                <th style=\"text-align: right;\">Amount</th>\n"
"            </tr>\n"
"        </thead>\n"
"        <tbody>\n"
"            <tr t-foreach=\"object.sudo().vendor_order_ids\" t-as=\"vo\">\n"
"                <td t-out=\"vo.name\"/>\n"
"                <td t-out=\"vo.vendor_id.vendor_store_name or vo.vendor_id.name\"/>\n"
"                <td><t t-if=\"vo.payment_method == 'cod'\">Cash on Delivery</t><t t-else=\"\">Online Payment</t></td>\n"
"                <td style=\"text-align: right;\" t-out=\"vo.amount_total\" t-options=\"{'widget': 'monetary', 'display_currency': vo.currency_id}\"/>\n"
"            </tr>\n"
"        </tbody>\n"
"    </table>\n"
"    <p>You can follow every shipment under Marketplace Orders in your account.</p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"    <p>مرحباً <t t-out=\"object.partner_id.name or ''\"/>,</p>\n"
"    <p>شكراً لطلبك <strong t-out=\"object.name\"/>. تم تقسيمه إلى الطلبات التالية، ويجهّز كل بائع طلبه:</p>\n"
"    <table style=\"width: 100%; border-collapse: collapse;\">\n"
"        <thead>\n"
"            <tr>\n"
"                <th style=\"text-align: left;\">الطلب</th>\n"
"                <th style=\"text-align: left;\">البائع</th>\n"
"                <th style=\"text-align: left;\">الدفع</th>\n"
"                <th style=\"text-align: right;\">المبلغ</th>\n"
"            </tr>\n"
"        </thead>\n"
"        <tbody>\n"
"            <tr t-foreach=\"object.sudo().vendor_order_ids\" t-as=\"vo\">\n"
"                <td t-out=\"vo.name\"/>\n"
"                <td t-out=\"vo.vendor_id.vendor_store_name or vo.vendor_id.name\"/>\n"
"                <td><t t-if=\"vo.payment_method == 'cod'\">الدفع عند الاستلام</t><t t-else=\"\">الدفع الإلكتروني</t></td>\n"
"                <td style=\"text-align: right;\" t-out=\"vo.amount_total\" t-options=\"{'widget': 'monetary', 'display_currency': vo.currency_id}\"/>\n"
"            </tr>\n"
"        </tbody>\n"
"    </table>\n"
"    <p>يمكنك متابعة كل شحنة من طلبات السوق في حسابك.</p>\n"
"</div>\n"
"            "

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_vendor_bank_change_requested
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p><strong>Security notice.</strong> A change of your payout bank account was requested<t t-if=\"object.requested_by\"> by <t t-out=\"object.requested_by.name\"/></t> (request <t t-out=\"object.name\"/>).</p>\n"
"<p>New account: <t t-out=\"object.bank_name\"/>, <t t-out=\"object.account_holder\"/>, <t t-out=\"object.masked_account_number\"/>.</p>\n"
"<p>The marketplace reviews it before it replaces your current account, and payouts are held meanwhile. If you did not make this request, contact the marketplace immediately and change your password.</p>\n"
"<p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/profile\">Open your profile</a></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p><strong>تنبيه أمني.</strong> تم طلب تغيير حساب صرف المستحقات البنكي الخاص بك<t t-if=\"object.requested_by\"> بواسطة <t t-out=\"object.requested_by.name\"/></t> (الطلب <t t-out=\"object.name\"/>).</p>\n"
"<p>الحساب الجديد: <t t-out=\"object.bank_name\"/>, <t t-out=\"object.account_holder\"/>, <t t-out=\"object.masked_account_number\"/>.</p>\n"
"<p>يراجعه السوق قبل أن يحل محل حسابك الحالي، وتُحجب المدفوعات في هذه الأثناء. إذا لم تقدّم هذا الطلب، فتواصل مع السوق فورًا وغيّر كلمة المرور الخاصة بك.</p>\n"
"<p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/profile\">افتح ملفك الشخصي</a></p>\n"
"</div>\n"
"            "

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_vendor_penalty_applied
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>A <strong t-out=\"dict(object._fields['level']._description_selection(object.env)).get(object.level)\"/> was applied to your store.</p><p>Reason: <t t-out=\"object.reason\"/></p>\n"
"<p t-if=\"object.amount\">Fine: <t t-out=\"object.amount\" t-options=\"{'widget': 'monetary', 'display_currency': object.currency_id}\"/></p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor\">Open in your vendor portal</a></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>تم تطبيق <strong t-out=\"dict(object._fields['level']._description_selection(object.env)).get(object.level)\"/> على متجرك.</p><p>السبب: <t t-out=\"object.reason\"/></p>\n"
"<p t-if=\"object.amount\">الغرامة: <t t-out=\"object.amount\" t-options=\"{'widget': 'monetary', 'display_currency': object.currency_id}\"/></p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor\">افتح في بوابة البائع</a></p>\n"
"</div>\n"
"            "

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_vendor_question_asked
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>A customer asked a question about <strong t-out=\"object.product_tmpl_id.name\"/>:</p>\n"
"<blockquote style=\"white-space: pre-line;\" t-out=\"object.question\" data-o-mail-quote-node=\"1\" data-o-mail-quote=\"1\"/>\n"
"<p>Any seller with an active offer on this product can answer. <a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/questions\">Answer the question</a></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>سأل أحد العملاء سؤالًا عن <strong t-out=\"object.product_tmpl_id.name\"/>:</p>\n"
"<blockquote style=\"white-space: pre-line;\" t-out=\"object.question\" data-o-mail-quote-node=\"1\" data-o-mail-quote=\"1\"/>\n"
"<p>يمكن لأي بائع لديه عرض نشط على هذا المنتج الإجابة. <a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/questions\">أجب عن السؤال</a></p>\n"
"</div>\n"
"            "

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_vendor_return_requested
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>A customer requested a return <strong t-out=\"object.name\"/> for order <t t-out=\"object.vendor_order_id.name\"/>.</p>\n"
"<p>Reason: <t t-out=\"object.reason\"/></p><p>Please answer before <t t-out=\"object.vendor_deadline\"/>, otherwise it is escalated to the marketplace.</p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/returns/{{ object.id }}\">Open in your vendor portal</a></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>طلب أحد العملاء مرتجعاً <strong t-out=\"object.name\"/> للطلب <t t-out=\"object.vendor_order_id.name\"/>.</p>\n"
"<p>السبب: <t t-out=\"object.reason\"/></p><p>يرجى الرد قبل <t t-out=\"object.vendor_deadline\"/>، وإلا سيتم تصعيده إلى السوق.</p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/returns/{{ object.id }}\">افتح في بوابة البائع</a></p>\n"
"</div>\n"
"            "

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_vendor_dispute_opened
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>A dispute <strong t-out=\"object.name\"/> was opened on order <t t-out=\"object.vendor_order_id.name\"/>.</p><p>Reason: <t t-out=\"object.reason\"/></p>\n"
"<p>Please reply before <t t-out=\"object.vendor_deadline\"/>.</p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/disputes/{{ object.id }}\">Open in your vendor portal</a></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>تم فتح نزاع <strong t-out=\"object.name\"/> على الطلب <t t-out=\"object.vendor_order_id.name\"/>.</p><p>السبب: <t t-out=\"object.reason\"/></p>\n"
"<p>يرجى الرد قبل <t t-out=\"object.vendor_deadline\"/>.</p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/disputes/{{ object.id }}\">افتح في بوابة البائع</a></p>\n"
"</div>\n"
"            "

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_vendor_application_approved
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>Congratulations! Your application <strong t-out=\"object.name\"/> was approved.</p>\n"
"<p>You will receive a separate email to set your password. Then sign in to manage your store.</p><p><a t-attf-href=\"{{ object.get_base_url() }}/my\">Go to your account</a></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>تهانينا! تم اعتماد طلب انضمامك <strong t-out=\"object.name\"/>.</p>\n"
"<p>ستصلك رسالة بريد إلكتروني منفصلة لتعيين كلمة المرور. ثم سجّل الدخول لإدارة متجرك.</p><p><a t-attf-href=\"{{ object.get_base_url() }}/my\">انتقل إلى حسابك</a></p>\n"
"</div>\n"
"            "

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_customer_order_shipped
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>Good news: shipment <strong t-out=\"object.name\"/> of your order <t t-out=\"object.vendor_order_id.name\"/> is on its way.</p>\n"
"<p t-if=\"object.tracking_ref\">Tracking reference: <strong t-out=\"object.tracking_ref\"/></p><p t-if=\"object.carrier_id\">Carrier: <t t-out=\"object.carrier_id.name\"/></p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/marketplace/orders/{{ object.vendor_order_id.id }}\">Follow your order</a></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>أخبار سارة: الشحنة <strong t-out=\"object.name\"/> من طلبك <t t-out=\"object.vendor_order_id.name\"/> في الطريق إليك.</p>\n"
"<p t-if=\"object.tracking_ref\">رقم التتبع: <strong t-out=\"object.tracking_ref\"/></p><p t-if=\"object.carrier_id\">شركة الشحن: <t t-out=\"object.carrier_id.name\"/></p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/marketplace/orders/{{ object.vendor_order_id.id }}\">تابع طلبك</a></p>\n"
"</div>\n"
"            "

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_vendor_order_late
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>Order <strong t-out=\"object.name\"/> should have shipped by <t t-out=\"object.ship_by_date\" t-options=\"{'widget': 'datetime'}\"/> and has not left yet. Please ship it as soon as possible: late shipments count against your performance.</p>\n"
"<p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/orders/{{ object.id }}\">Open the order</a></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>الطلب <strong t-out=\"object.name\"/> كان يجب شحنه قبل <t t-out=\"object.ship_by_date\" t-options=\"{'widget': 'datetime'}\"/> ولم يغادر بعد. يرجى شحنه في أقرب وقت ممكن: تؤثر الشحنات المتأخرة سلبًا على أدائك.</p>\n"
"<p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/orders/{{ object.id }}\">افتح الطلب</a></p>\n"
"</div>\n"
"            "

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_customer_order_delivered
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>Shipment <strong t-out=\"object.name\"/> of your order <t t-out=\"object.vendor_order_id.name\"/> was delivered. Thank you!</p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/marketplace/orders/{{ object.vendor_order_id.id }}\">Follow your order</a></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>تم تسليم الشحنة <strong t-out=\"object.name\"/> من طلبك <t t-out=\"object.vendor_order_id.name\"/>. شكراً لك!</p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/marketplace/orders/{{ object.vendor_order_id.id }}\">تابع طلبك</a></p>\n"
"</div>\n"
"            "

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_vendor_penalty_lifted
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>The <strong t-out=\"dict(object._fields['level']._description_selection(object.env)).get(object.level)\"/> on your store was lifted.</p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor\">Open in your vendor portal</a></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>تم رفع <strong t-out=\"dict(object._fields['level']._description_selection(object.env)).get(object.level)\"/> عن متجرك.</p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor\">افتح في بوابة البائع</a></p>\n"
"</div>\n"
"            "

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_vendor_order_cancelled_by_customer
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>The customer cancelled order <strong t-out=\"object.name\"/>. <strong>Do not ship it.</strong></p><p t-if=\"object.cancel_reason\">Reason: <t t-out=\"object.cancel_reason\"/></p>\n"
"<p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/orders/{{ object.id }}\">Open the order</a></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>ألغى العميل الطلب <strong t-out=\"object.name\"/>. <strong>لا تشحنه.</strong></p><p t-if=\"object.cancel_reason\">السبب: <t t-out=\"object.cancel_reason\"/></p>\n"
"<p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/orders/{{ object.id }}\">افتح الطلب</a></p>\n"
"</div>\n"
"            "

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_vendor_dispute_escalated
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>The dispute <strong t-out=\"object.name\"/> was escalated to the marketplace.</p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/disputes/{{ object.id }}\">Open in your vendor portal</a></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>تم تصعيد النزاع <strong t-out=\"object.name\"/> إلى السوق.</p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/disputes/{{ object.id }}\">افتح في بوابة البائع</a></p>\n"
"</div>\n"
"            "

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_vendor_return_decided
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>The marketplace decided on return <strong t-out=\"object.name\"/>: <strong><t t-if=\"object.state == 'closed'\">rejected</t><t t-else=\"\">approved</t></strong>.</p>\n"
"<p t-if=\"object.decision_note\">Decision: <t t-out=\"object.decision_note\"/></p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/returns/{{ object.id }}\">Open in your vendor portal</a></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>قرر السوق بشأن المرتجع <strong t-out=\"object.name\"/>: <strong><t t-if=\"object.state == 'closed'\">مرفوض</t><t t-else=\"\">معتمد</t></strong>.</p>\n"
"<p t-if=\"object.decision_note\">القرار: <t t-out=\"object.decision_note\"/></p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/returns/{{ object.id }}\">افتح في بوابة البائع</a></p>\n"
"</div>\n"
"            "

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_vendor_dispute_resolved
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>The marketplace resolved dispute <strong t-out=\"object.name\"/>.</p><p>Decision: <t t-out=\"object.decision\"/></p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/disputes/{{ object.id }}\">Open in your vendor portal</a></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>قام السوق بحل النزاع <strong t-out=\"object.name\"/>.</p><p>القرار: <t t-out=\"object.decision\"/></p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/disputes/{{ object.id }}\">افتح في بوابة البائع</a></p>\n"
"</div>\n"
"            "

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_vendor_return_escalated
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>The return <strong t-out=\"object.name\"/> was escalated to the marketplace for a decision.</p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/returns/{{ object.id }}\">Open in your vendor portal</a></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>تم تصعيد المرتجع <strong t-out=\"object.name\"/> إلى السوق لاتخاذ قرار.</p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/returns/{{ object.id }}\">افتح في بوابة البائع</a></p>\n"
"</div>\n"
"            "

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_vendor_application_rejected
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>We are sorry: your application <strong t-out=\"object.name\"/> was rejected.</p><p>Reason: <t t-out=\"object.reject_reason\"/></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>نأسف: تم رفض طلب انضمامك <strong t-out=\"object.name\"/>.</p><p>السبب: <t t-out=\"object.reject_reason\"/></p>\n"
"</div>\n"
"            "

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_customer_order_cancelled_by_customer
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>We cancelled order <strong t-out=\"object.name\"/> as you asked.</p><p t-if=\"object.cancel_reason\">Reason: <t t-out=\"object.cancel_reason\"/></p>\n"
"<p t-if=\"object.payment_method != 'cod'\">If you already paid online, a refund of <t t-out=\"object.amount_total\" t-options=\"{'widget': 'monetary', 'display_currency': object.currency_id}\"/> is being processed.</p><p t-else=\"\">You had chosen Cash on Delivery, so nothing was charged.</p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/marketplace/orders/{{ object.id }}\">See your order</a></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>لقد ألغينا الطلب <strong t-out=\"object.name\"/> بناءً على طلبك.</p><p t-if=\"object.cancel_reason\">السبب: <t t-out=\"object.cancel_reason\"/></p>\n"
"<p t-if=\"object.payment_method != 'cod'\">إذا كنت قد دفعت عبر الإنترنت، فإن استرداد مبلغ <t t-out=\"object.amount_total\" t-options=\"{'widget': 'monetary', 'display_currency': object.currency_id}\"/> قيد المعالجة.</p><p t-else=\"\">لقد اخترت الدفع عند الاستلام، لذلك لم يتم خصم أي مبلغ.</p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/marketplace/orders/{{ object.id }}\">عرض طلبك</a></p>\n"
"</div>\n"
"            "

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_customer_order_cancelled_by_customer_company
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>We cancelled order <strong t-out=\"object.name\"/> as you asked.</p><p t-if=\"object.leaders_cancel_reason_id\">Reason: <t t-out=\"object.leaders_cancel_reason_id.name\"/><t t-if=\"object.leaders_cancel_note\">: <t t-out=\"object.leaders_cancel_note\"/></t></p>\n"
"<p t-if=\"object.leaders_payment_method != 'cod'\">If you already paid online, a refund of <t t-out=\"object.amount_total\" t-options=\"{'widget': 'monetary', 'display_currency': object.currency_id}\"/> is being processed.</p><p t-else=\"\">You had chosen Cash on Delivery, so nothing was charged.</p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/marketplace/checkouts/{{ object.id }}\">See your order</a></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>قمنا بإلغاء الطلب <strong t-out=\"object.name\"/> بناءً على طلبك.</p><p t-if=\"object.leaders_cancel_reason_id\">السبب: <t t-out=\"object.leaders_cancel_reason_id.name\"/><t t-if=\"object.leaders_cancel_note\">: <t t-out=\"object.leaders_cancel_note\"/></t></p>\n"
"<p t-if=\"object.leaders_payment_method != 'cod'\">إذا كنت قد دفعت أونلاين، فإن استرداد مبلغ <t t-out=\"object.amount_total\" t-options=\"{'widget': 'monetary', 'display_currency': object.currency_id}\"/> قيد المعالجة.</p><p t-else=\"\">لقد اخترت الدفع عند الاستلام، لذلك لم يتم تحصيل أي مبلغ.</p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/marketplace/checkouts/{{ object.id }}\">عرض طلبك</a></p>\n"
"</div>"

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_vendor_order_confirmed
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>You have a new order <strong t-out=\"object.name\"/> worth <t t-out=\"object.amount_total\" t-options=\"{'widget': 'monetary', 'display_currency': object.currency_id}\"/>.</p>\n"
"<ul>\n"
"<t t-foreach=\"object.line_ids\" t-as=\"l\"><li t-if=\"not l.is_delivery\"><t t-out=\"'%g' % l.product_uom_qty\"/> x <t t-out=\"l.name\"/></li></t>\n"
"</ul>\n"
"<p>Fulfilment: <t t-foreach=\"object.fulfillment_group_ids\" t-as=\"g\"><t t-out=\"g.name\"/> (<t t-out=\"(g.fulfillment_type or '').upper()\"/>) </t></p>\n"
"<p>Ship-by: please prepare it now and, for vendor-fulfilled (FBM) shipments, enter the tracking reference as soon as it leaves. Leaders-fulfilled (FBL) shipments are handled by our warehouse.</p>\n"
"<p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/orders/{{ object.id }}\">Open in your vendor portal</a></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>لديك طلب جديد <strong t-out=\"object.name\"/> بقيمة <t t-out=\"object.amount_total\" t-options=\"{'widget': 'monetary', 'display_currency': object.currency_id}\"/>.</p>\n"
"<ul>\n"
"<t t-foreach=\"object.line_ids\" t-as=\"l\"><li t-if=\"not l.is_delivery\"><t t-out=\"'%g' % l.product_uom_qty\"/> x <t t-out=\"l.name\"/></li></t>\n"
"</ul>\n"
"<p>التنفيذ: <t t-foreach=\"object.fulfillment_group_ids\" t-as=\"g\"><t t-out=\"g.name\"/> (<t t-out=\"(g.fulfillment_type or '').upper()\"/>) </t></p>\n"
"<p>موعد الشحن: يرجى تجهيزه الآن، وبالنسبة للشحنات التي ينفذها البائع (FBM) أدخل رقم التتبع فور خروجها. أما الشحنات التي تنفذها ليدرز (FBL) فيتولاها مستودعنا.</p>\n"
"<p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/orders/{{ object.id }}\">افتح في بوابة البائع</a></p>\n"
"</div>\n"
"            "

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_vendor_offer_approved
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>Your offer <strong t-out=\"object.seller_sku\"/> on <t t-out=\"object.product_id.display_name\"/> was approved.</p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/products/{{ object.id }}/edit\">Open in your vendor portal</a></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>عرضك <strong t-out=\"object.seller_sku\"/> على <t t-out=\"object.product_id.display_name\"/> تم اعتماده.</p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/products/{{ object.id }}/edit\">افتح في بوابة البائع</a></p>\n"
"</div>\n"
"            "

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_vendor_offer_rejected
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>Your offer <strong t-out=\"object.seller_sku\"/> on <t t-out=\"object.product_id.display_name\"/> was rejected.</p><p>Reason: <t t-out=\"object.reject_reason\"/></p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/products/{{ object.id }}/edit\">Open in your vendor portal</a></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>عرضك <strong t-out=\"object.seller_sku\"/> على <t t-out=\"object.product_id.display_name\"/> تم رفضه.</p><p>السبب: <t t-out=\"object.reject_reason\"/></p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/products/{{ object.id }}/edit\">افتح في بوابة البائع</a></p>\n"
"</div>\n"
"            "

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_customer_order_cancelled
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>Your order <strong t-out=\"object.name\"/> was cancelled.</p><p t-if=\"object.cancel_reason\">Reason: <t t-out=\"object.cancel_reason\"/></p>\n"
"<p t-if=\"object.payment_method != 'cod'\">If you already paid online, a refund of <t t-out=\"object.amount_total\" t-options=\"{'widget': 'monetary', 'display_currency': object.currency_id}\"/> is being prepared.</p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/marketplace/orders/{{ object.id }}\">Follow your order</a></p>\n"
"</div>\n"
