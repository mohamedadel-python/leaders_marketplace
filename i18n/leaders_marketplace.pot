#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_vendor_application_submitted
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"    <p>Hello <t t-out=\"object.owner_name or ''\"/>,</p>\n"
"    <p>We received your application to sell on our marketplace. Your reference is <strong t-out=\"object.name\"/>.</p>\n"
"    <p>You can follow its progress, see what is still missing and re-upload documents here:</p>\n"
"    <p><a t-attf-href=\"{{ object.get_base_url() }}/vendor/apply/status/{{ object.access_token }}\">Application status</a></p>\n"
"</div>\n"
"            "
msgstr ""

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_marketplace_order_confirmation
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"    <p>Hello <t t-out=\"object.partner_id.name or ''\"/>,</p>\n"
"    <p>Thank you for your order <strong t-out=\"object.name\"/>. It has been split into the following orders, each prepared by its seller:</p>\n"
"    <table style=\"width: 100%; border-collapse: collapse;\">\n"
"        <thead>\n"
"            <tr>\n"
"                <th style=\"text-align: left;\">Order</th>\n"
"                <th style=\"text-align: left;\">Seller</th>\n"
"                <th style=\"text-align: left;\">Payment</th>\n"
"                <th style=\"text-align: right;\">Amount</th>\n"
"            </tr>\n"
"        </thead>\n"
"        <tbody>\n"
"            <tr t-foreach=\"object.sudo().vendor_order_ids\" t-as=\"vo\">\n"
"                <td t-out=\"vo.name\"/>\n"
"                <td t-out=\"vo.vendor_id.vendor_store_name or vo.vendor_id.name\"/>\n"
"                <td><t t-if=\"vo.payment_method == 'cod'\">Cash on Delivery</t><t t-else=\"\">Online Payment</t></td>\n"
"                <td style=\"text-align: right;\" t-out=\"vo.amount_total\" t-options=\"{'widget': 'monetary', 'display_currency': vo.currency_id}\"/>\n"
"            </tr>\n"
"        </tbody>\n"
"    </table>\n"
"    <p>You can follow every shipment under Marketplace Orders in your account.</p>\n"
"</div>\n"
"            "
msgstr ""

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_vendor_bank_change_requested
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p><strong>Security notice.</strong> A change of your payout bank account was requested<t t-if=\"object.requested_by\"> by <t t-out=\"object.requested_by.name\"/></t> (request <t t-out=\"object.name\"/>).</p>\n"
"<p>New account: <t t-out=\"object.bank_name\"/>, <t t-out=\"object.account_holder\"/>, <t t-out=\"object.masked_account_number\"/>.</p>\n"
"<p>The marketplace reviews it before it replaces your current account, and payouts are held meanwhile. If you did not make this request, contact the marketplace immediately and change your password.</p>\n"
"<p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/profile\">Open your profile</a></p>\n"
"</div>\n"
"            "
msgstr ""

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_vendor_penalty_applied
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>A <strong t-out=\"dict(object._fields['level']._description_selection(object.env)).get(object.level)\"/> was applied to your store.</p><p>Reason: <t t-out=\"object.reason\"/></p>\n"
"<p t-if=\"object.amount\">Fine: <t t-out=\"object.amount\" t-options=\"{'widget': 'monetary', 'display_currency': object.currency_id}\"/></p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor\">Open in your vendor portal</a></p>\n"
"</div>\n"
"            "
msgstr ""

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_vendor_question_asked
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>A customer asked a question about <strong t-out=\"object.product_tmpl_id.name\"/>:</p>\n"
"<blockquote style=\"white-space: pre-line;\" t-out=\"object.question\" data-o-mail-quote-node=\"1\" data-o-mail-quote=\"1\"/>\n"
"<p>Any seller with an active offer on this product can answer. <a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/questions\">Answer the question</a></p>\n"
"</div>\n"
"            "
msgstr ""

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_vendor_return_requested
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>A customer requested a return <strong t-out=\"object.name\"/> for order <t t-out=\"object.vendor_order_id.name\"/>.</p>\n"
"<p>Reason: <t t-out=\"object.reason\"/></p><p>Please answer before <t t-out=\"object.vendor_deadline\"/>, otherwise it is escalated to the marketplace.</p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/returns/{{ object.id }}\">Open in your vendor portal</a></p>\n"
"</div>\n"
"            "
msgstr ""

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_vendor_dispute_opened
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>A dispute <strong t-out=\"object.name\"/> was opened on order <t t-out=\"object.vendor_order_id.name\"/>.</p><p>Reason: <t t-out=\"object.reason\"/></p>\n"
"<p>Please reply before <t t-out=\"object.vendor_deadline\"/>.</p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/disputes/{{ object.id }}\">Open in your vendor portal</a></p>\n"
"</div>\n"
"            "
msgstr ""

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_vendor_application_approved
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>Congratulations! Your application <strong t-out=\"object.name\"/> was approved.</p>\n"
"<p>You will receive a separate email to set your password. Then sign in to manage your store.</p><p><a t-attf-href=\"{{ object.get_base_url() }}/my\">Go to your account</a></p>\n"
"</div>\n"
"            "
msgstr ""

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_customer_order_shipped
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>Good news: shipment <strong t-out=\"object.name\"/> of your order <t t-out=\"object.vendor_order_id.name\"/> is on its way.</p>\n"
"<p t-if=\"object.tracking_ref\">Tracking reference: <strong t-out=\"object.tracking_ref\"/></p><p t-if=\"object.carrier_id\">Carrier: <t t-out=\"object.carrier_id.name\"/></p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/marketplace/orders/{{ object.vendor_order_id.id }}\">Follow your order</a></p>\n"
"</div>\n"
"            "
msgstr ""

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_vendor_order_late
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>Order <strong t-out=\"object.name\"/> should have shipped by <t t-out=\"object.ship_by_date\" t-options=\"{'widget': 'datetime'}\"/> and has not left yet. Please ship it as soon as possible: late shipments count against your performance.</p>\n"
"<p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/orders/{{ object.id }}\">Open the order</a></p>\n"
"</div>\n"
"            "
msgstr ""

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_customer_order_delivered
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>Shipment <strong t-out=\"object.name\"/> of your order <t t-out=\"object.vendor_order_id.name\"/> was delivered. Thank you!</p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/marketplace/orders/{{ object.vendor_order_id.id }}\">Follow your order</a></p>\n"
"</div>\n"
"            "
msgstr ""

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_vendor_penalty_lifted
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>The <strong t-out=\"dict(object._fields['level']._description_selection(object.env)).get(object.level)\"/> on your store was lifted.</p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor\">Open in your vendor portal</a></p>\n"
"</div>\n"
"            "
msgstr ""

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_vendor_order_cancelled_by_customer
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>The customer cancelled order <strong t-out=\"object.name\"/>. <strong>Do not ship it.</strong></p><p t-if=\"object.cancel_reason\">Reason: <t t-out=\"object.cancel_reason\"/></p>\n"
"<p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/orders/{{ object.id }}\">Open the order</a></p>\n"
"</div>\n"
"            "
msgstr ""

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_vendor_dispute_escalated
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>The dispute <strong t-out=\"object.name\"/> was escalated to the marketplace.</p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/disputes/{{ object.id }}\">Open in your vendor portal</a></p>\n"
"</div>\n"
"            "
msgstr ""

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_vendor_return_decided
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>The marketplace decided on return <strong t-out=\"object.name\"/>: <strong><t t-if=\"object.state == 'closed'\">rejected</t><t t-else=\"\">approved</t></strong>.</p>\n"
"<p t-if=\"object.decision_note\">Decision: <t t-out=\"object.decision_note\"/></p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/returns/{{ object.id }}\">Open in your vendor portal</a></p>\n"
"</div>\n"
"            "
msgstr ""

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_vendor_dispute_resolved
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>The marketplace resolved dispute <strong t-out=\"object.name\"/>.</p><p>Decision: <t t-out=\"object.decision\"/></p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/disputes/{{ object.id }}\">Open in your vendor portal</a></p>\n"
"</div>\n"
"            "
msgstr ""

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_vendor_return_escalated
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>The return <strong t-out=\"object.name\"/> was escalated to the marketplace for a decision.</p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/vendor/returns/{{ object.id }}\">Open in your vendor portal</a></p>\n"
"</div>\n"
"            "
msgstr ""

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_vendor_application_rejected
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>We are sorry: your application <strong t-out=\"object.name\"/> was rejected.</p><p>Reason: <t t-out=\"object.reject_reason\"/></p>\n"
"</div>\n"
"            "
msgstr ""

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_customer_order_cancelled_by_customer
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>We cancelled order <strong t-out=\"object.name\"/> as you asked.</p><p t-if=\"object.cancel_reason\">Reason: <t t-out=\"object.cancel_reason\"/></p>\n"
"<p t-if=\"object.payment_method != 'cod'\">If you already paid online, a refund of <t t-out=\"object.amount_total\" t-options=\"{'widget': 'monetary', 'display_currency': object.currency_id}\"/> is being processed.</p><p t-else=\"\">You had chosen Cash on Delivery, so nothing was charged.</p><p><a t-attf-href=\"{{ object.get_base_url() }}/my/marketplace/orders/{{ object.id }}\">See your order</a></p>\n"
"</div>\n"
"            "
msgstr ""

#. module: leaders_marketplace
#: model:mail.template,body_html:leaders_marketplace.mail_template_vendor_order_confirmed
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p>You have a new order <strong t-out=\"object.name\"/> worth <t t-out=\"object.amount_total\" t-options=\"{'widget': 'monetary', 'display_currency': object.currency_id}\"/>.</p>\n"
"<ul>\n"
"<t t-foreach=\"object.line_ids\" t-as=\"l\"><li t-if=\"not l.is_delivery\"><t t-out=\"'%g' % l.product_uom_qty\"/> x <t t-out=\"l.name\"/></li></t>\n"
"</ul>\n"
"<p>Fulfilment: <t t-foreach=\"object.fulfillment_group_ids\" t-as=\"g\"><t t-out=\"g.name\"/> (<t t-out=\"(g.fulfillment_type or '').upper()\"/>) </t></p>\n"
"<p>Ship-by: please prepare it now and, for vendor-fulfilled (FBM) shipments, enter the tracking reference as soon as it leaves. Leaders-fulfilled (FBL) shipments are handled by our warehouse.</p>\n"
