<odoo>
    <record id="module_category_marketplace" model="ir.module.category">
        <field name="name">Marketplace</field><field name="sequence">40</field>
    </record>
    <record id="group_vendor_staff" model="res.groups">
        <field name="name">Vendor Staff</field>
        <field name="category_id" ref="leaders_marketplace.module_category_marketplace"/>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    </record>
    <record id="group_vendor_owner" model="res.groups">
        <field name="name">Vendor Owner</field>
        <field name="category_id" ref="leaders_marketplace.module_category_marketplace"/>
        <field name="implied_ids" eval="[(4, ref('leaders_marketplace.group_vendor_staff'))]"/>
    </record>
    <record id="group_marketplace_reviewer" model="res.groups">
        <field name="name">Marketplace Reviewer</field>
        <field name="category_id" ref="leaders_marketplace.module_category_marketplace"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_marketplace_finance" model="res.groups">
        <field name="name">Marketplace Finance</field>
        <field name="category_id" ref="leaders_marketplace.module_category_marketplace"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
    </record>
    <record id="group_marketplace_manager" model="res.groups">
        <field name="name">Marketplace Manager</field>
        <field name="category_id" ref="leaders_marketplace.module_category_marketplace"/>
        <field name="implied_ids" eval="[(4, ref('leaders_marketplace.group_marketplace_reviewer')),(4, ref('leaders_marketplace.group_marketplace_finance'))]"/>
    </record>
</odoo>
