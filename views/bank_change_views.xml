<odoo>
    <record id="view_vendor_bank_change_tree" model="ir.ui.view">
        <field name="name">leaders.vendor.bank.change.tree</field>
        <field name="model">leaders.vendor.bank.change</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'pending'" decoration-muted="state == 'rejected'">
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="bank_name"/>
                <field name="masked_account_number"/>
                <field name="create_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_vendor_bank_change_form" model="ir.ui.view">
        <field name="name">leaders.vendor.bank.change.form</field>
        <field name="model">leaders.vendor.bank.change</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary" invisible="state != 'pending'"
                            confirm="Approve this change? Settlements will be paid to the new account."/>
                    <button name="action_reject" string="Reject" type="object" invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Request">
                            <field name="vendor_id" readonly="state != 'pending' or id"/>
                            <field name="requested_by"/>
                            <field name="bank_name" readonly="state != 'pending'"/>
                            <field name="account_holder" readonly="state != 'pending'"/>
                            <field name="account_number" readonly="state != 'pending'"/>
                            <field name="proof" filename="proof_name" readonly="state != 'pending'"/>
                            <field name="proof_name" invisible="1"/>
                        </group>
                        <group string="Review">
                            <field name="reject_reason" readonly="state != 'pending'" placeholder="Required to reject"/>
                            <field name="reviewed_by"/>
                            <field name="reviewed_date"/>
                            <field name="previous_bank_id"/>
                            <field name="bank_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_vendor_bank_change_search" model="ir.ui.view">
        <field name="name">leaders.vendor.bank.change.search</field>
        <field name="model">leaders.vendor.bank.change</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="vendor_id"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_vendor" string="Vendor" context="{'group_by': 'vendor_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_vendor_bank_change" model="ir.actions.act_window">
        <field name="name">Payout Account Changes</field>
        <field name="res_model">leaders.vendor.bank.change</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
    <menuitem id="menu_vendor_bank_changes" name="Payout Account Changes" parent="menu_marketplace_operations"
              action="action_vendor_bank_change" sequence="60"
              groups="leaders_marketplace.group_marketplace_finance,leaders_marketplace.group_marketplace_manager"/>
</odoo>
