<odoo>
    <template id="cart_marketplace_price_changed" inherit_id="website_sale.cart">
        <xpath expr="//h3[normalize-space(text())='Order overview']" position="before">
            <div t-if="request.params.get('lm_price_changed')" class="alert alert-warning" role="alert">
                Prices of some items changed, please review your cart
            </div>
        </xpath>
    </template>
    <template id="checkout_cash_on_delivery" inherit_id="website_sale.payment">
        <xpath expr="//div[@id='payment_method']" position="after">
            <div t-if="marketplace_cod_enabled and not errors" class="mt-3">
                <form action="/shop/payment/cod" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <button type="submit" class="btn btn-secondary">
                        <i class="fa fa-money"/> Pay Cash on Delivery
                    </button>
                </form>
            </div>
        </xpath>
    </template>
</odoo>
