<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_return_reason_list" model="ir.ui.view">
        <field name="name">leaders.return.reason.list</field>
        <field name="model">leaders.return.reason</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="requires_photo"/>
                <field name="customer_pays_shipping"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_return_reason_form" model="ir.ui.view">
        <field name="name">leaders.return.reason.form</field>
        <field name="model">leaders.return.reason</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="requires_photo"/>
                        <field name="customer_pays_shipping"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_return_reason_search" model="ir.ui.view">
        <field name="name">leaders.return.reason.search</field>
        <field name="model">leaders.return.reason</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="action_return_reason" model="ir.actions.act_window">
        <field name="name">Return Reasons</field>
        <field name="res_model">leaders.return.reason</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_return_reasons" name="Return Reasons" parent="menu_configuration" action="action_return_reason" sequence="45"/>
</odoo>
