<odoo>
    <record id="view_settlement_tree" model="ir.ui.view">
        <field name="name">leaders.settlement.tree</field>
        <field name="model">leaders.settlement</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="period_from"/>
                <field name="period_to"/>
                <field name="gross_amount"/>
                <field name="deductions"/>
                <field name="net_amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_settlement_form" model="ir.ui.view">
        <field name="name">leaders.settlement.form</field>
        <field name="model">leaders.settlement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_collect_transactions" string="Collect Transactions" type="object" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" invisible="state != 'draft'"/>
                    <button name="action_mark_paid" string="Mark Paid" type="object" invisible="state != 'approved' or net_amount &lt; 0"/>
                    <button name="action_register_vendor_payment" string="Register Vendor Payment" type="object" invisible="state != 'approved' or net_amount &gt;= 0"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft', 'approved') or payment_move_id" confirm="Cancel this settlement? Its transactions are released and any commission it charged is credited back."/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="vendor_id"/>
                        <field name="period_from"/>
                        <field name="period_to"/>
                        <field name="currency_id"/>
                    </group>
                    <group>
                        <field name="gross_amount"/>
                        <field name="deductions"/>
                        <field name="net_amount"/>
                        <field name="payout_journal_id"/>
                        <field name="commission_move_id" readonly="1"/>
                        <field name="commission_invoice_id" readonly="1"/>
                        <field name="commission_invoice_offset_move_id" readonly="1"/>
                        <field name="payment_move_id" readonly="1"/>
                    </group>
                    <field name="commission_achievement_ids" readonly="1">
                        <list>
                            <field name="rule_id"/>
                            <field name="sales_amount"/>
                            <field name="target_amount"/>
                            <field name="achievement_percent"/>
                            <field name="commission_amount"/>
                            <field name="effect"/>
                            <field name="cancelled" optional="hide"/>
                        </list>
                    </field>
                    <field name="transaction_ids">
                        <list>
                            <field name="available_date"/>
                            <field name="type"/>
                            <field name="reference"/>
                            <field name="amount"/>
                            <field name="state"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_settlement" model="ir.actions.act_window">
        <field name="name">Settlements</field>
        <field name="res_model">leaders.settlement</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_cod_vendor_order_list" model="ir.ui.view">
        <field name="name">leaders.vendor.order.cod.list</field>
        <field name="model">leaders.vendor.order</field>
        <field name="arch" type="xml">
            <list create="false" decoration-warning="not cod_payment_id and state == 'completed'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="date_order"/>
                <field name="vendor_id"/>
                <field name="partner_id"/>
                <field name="state"/>
                <field name="cod_cash_confirmed" string="Vendor Confirmed"/>
                <field name="cod_payment_id" string="Cash Receipt"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="action_cod_vendor_order" model="ir.actions.act_window">
        <field name="name">Cash on Delivery</field>
        <field name="res_model">leaders.vendor.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('payment_method', '=', 'cod')]</field>
        <field name="context">{'search_default_group_state': 1}</field>
        <field name="view_id" ref="view_cod_vendor_order_list"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Cash on Delivery order yet.</p>
            <p>Orders highlighted in orange are delivered but have no cash receipt booked.</p>
        </field>
    </record>
    <record id="view_cod_vendor_order_search" model="ir.ui.view">
        <field name="name">leaders.vendor.order.cod.search</field>
        <field name="model">leaders.vendor.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="partner_id"/>
                <filter name="cod_not_collected" string="Cash Not Booked" domain="[('cod_payment_id', '=', False)]"/>
                <filter name="cod_collected" string="Cash Booked" domain="[('cod_payment_id', '!=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_vendor" string="Vendor" context="{'group_by': 'vendor_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
