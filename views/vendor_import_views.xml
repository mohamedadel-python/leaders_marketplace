<odoo>
    <record id="view_vendor_import_list" model="ir.ui.view">
        <field name="name">leaders.vendor.import.list</field>
        <field name="model">leaders.vendor.import</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-danger="state == 'failed'" decoration-success="state == 'done'">
                <field name="create_date"/>
                <field name="vendor_id"/>
                <field name="kind"/>
                <field name="filename"/>
                <field name="state"/>
                <field name="total_rows"/>
                <field name="valid_rows"/>
                <field name="invalid_rows"/>
                <field name="applied_rows"/>
                <field name="failed_rows"/>
            </list>
        </field>
    </record>
    <record id="view_vendor_import_form" model="ir.ui.view">
        <field name="name">leaders.vendor.import.form</field>
        <field name="model">leaders.vendor.import</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <header><field name="state" widget="statusbar" statusbar_visible="uploaded,validated,confirmed,processing,done"/></header>
                <sheet>
                    <group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="user_id"/>
                            <field name="kind"/>
                            <field name="filename"/>
                            <field name="file" filename="filename"/>
                            <field name="submit_after_import"/>
                        </group>
                        <group>
                            <field name="total_rows"/>
                            <field name="valid_rows"/>
                            <field name="invalid_rows"/>
                            <field name="applied_rows"/>
                            <field name="failed_rows"/>
                            <field name="error_file" filename="error_filename"/>
                        </group>
                    </group>
                    <group string="Log"><field name="log" nolabel="1"/></group>
                    <field name="line_ids">
                        <list>
                            <field name="row_number"/>
                            <field name="status"/>
                            <field name="messages"/>
                            <field name="offer_id"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_vendor_import" model="ir.actions.act_window">
        <field name="name">Vendor Imports</field>
        <field name="res_model">leaders.vendor.import</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_vendor_imports" name="Vendor Imports" parent="menu_marketplace_operations" action="action_vendor_import" sequence="22" groups="leaders_marketplace.group_marketplace_manager"/>
</odoo>
