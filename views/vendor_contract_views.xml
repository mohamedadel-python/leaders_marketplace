<odoo>
    <!-- contract model switch requests (a vendor changes model after choosing it) -->
    <record id="view_leaders_contract_switch_list" model="ir.ui.view">
        <field name="name">leaders.contract.switch.list</field>
        <field name="model">leaders.contract.switch</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="create_date" string="Requested"/>
                <field name="vendor_id"/>
                <field name="from_model"/>
                <field name="to_model"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_leaders_contract_switch_form" model="ir.ui.view">
        <field name="name">leaders.contract.switch.form</field>
        <field name="model">leaders.contract.switch</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button name="action_approve" type="object" string="Approve switch" class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_reject" type="object" string="Reject switch" invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="vendor_id"/>
                        <field name="from_model"/>
                        <field name="to_model"/>
                        <field name="note"/>
                        <field name="reject_reason" readonly="state != 'pending'" placeholder="Required to reject; the vendor sees it."/>
                    </group>
                    <p class="text-muted">An approved switch applies to all the vendor's products at once.</p>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_leaders_contract_switch" model="ir.actions.act_window">
        <field name="name">Contract Switches</field>
        <field name="res_model">leaders.contract.switch</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_leaders_contract_switch" name="Contract Switches" parent="menu_marketplace_operations"
              action="action_leaders_contract_switch" sequence="12" groups="leaders_marketplace.group_marketplace_manager"/>

    <!-- every storefront account in one list: customers and vendors told apart -->
    <record id="view_leaders_platform_users_list" model="ir.ui.view">
        <field name="name">res.users.list.leaders.platform</field>
        <field name="model">res.users</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="name"/>
                <field name="login"/>
                <field name="phone"/>
                <field name="leaders_is_vendor" widget="boolean_toggle" readonly="1"/>
                <field name="leaders_email_verified" readonly="1"/>
                <field name="login_date" string="Last sign-in"/>
                <field name="create_date" string="Signed up"/>
            </list>
        </field>
    </record>
    <record id="view_leaders_platform_users_search" model="ir.ui.view">
        <field name="name">res.users.search.leaders.platform</field>
        <field name="model">res.users</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="login"/>
                <filter name="vendors" string="Vendors" domain="[('leaders_is_vendor', '=', True)]"/>
                <filter name="customers" string="Customers" domain="[('leaders_is_vendor', '=', False)]"/>
                <separator/>
                <filter name="unverified" string="Email not confirmed" domain="[('leaders_email_verified', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="by_type" string="Customer or vendor" context="{'group_by': 'leaders_is_vendor'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_leaders_platform_users" model="ir.actions.act_window">
        <field name="name">Platform Users</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list</field>
        <field name="domain">[('share', '=', True)]</field>
        <field name="context">{'search_default_by_type': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_leaders_platform_users_list')})]"/>
        <field name="search_view_id" ref="view_leaders_platform_users_search"/>
    </record>
    <menuitem id="menu_leaders_platform_users" name="Platform Users" parent="menu_marketplace_operations"
              action="action_leaders_platform_users" sequence="5" groups="leaders_marketplace.group_marketplace_manager"/>

    <record id="cron_leaders_contract_reminder" model="ir.cron">
        <field name="name">Vendors: Remind the Contract Model Choice</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model.cron_remind_contract_choice()</field>
        <field name="interval_number">1</field><field name="interval_type">days</field><field name="active">True</field>
    </record>
</odoo>
