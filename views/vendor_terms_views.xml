<odoo>
    <record id="view_vendor_terms_tree" model="ir.ui.view">
        <field name="name">leaders.vendor.terms.tree</field>
        <field name="model">leaders.vendor.terms</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="name"/>
                <field name="version"/>
                <field name="signed_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_vendor_terms_form" model="ir.ui.view">
        <field name="name">leaders.vendor.terms.form</field>
        <field name="model">leaders.vendor.terms</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="version"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="signed_count"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Only one version is active at a time. Activating a version deactivates the others and every vendor
                        must accept it before using the vendor portal again. With no active version nothing is required.
                    </div>
                    <field name="body"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_vendor_terms_search" model="ir.ui.view">
        <field name="name">leaders.vendor.terms.search</field>
        <field name="model">leaders.vendor.terms</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="action_vendor_terms" model="ir.actions.act_window">
        <field name="name">Vendor Terms</field>
        <field name="res_model">leaders.vendor.terms</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_vendor_contract_tree" model="ir.ui.view">
        <field name="name">leaders.vendor.contract.tree</field>
        <field name="model">leaders.vendor.contract</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'draft'" create="0">
                <field name="vendor_id"/>
                <field name="terms_id"/>
                <field name="terms_version"/>
                <field name="user_id"/>
                <field name="signed_at"/>
                <field name="signed_ip"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_vendor_contract_form" model="ir.ui.view">
        <field name="name">leaders.vendor.contract.form</field>
        <field name="model">leaders.vendor.contract</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_sign" string="Sign" type="object" class="btn-primary"
                            invisible="state != 'draft' or not signature"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,signed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="vendor_id" readonly="state == 'signed'"/>
                            <field name="terms_id" readonly="state == 'signed'"/>
                            <field name="terms_version"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="signed_at"/>
                            <field name="signed_ip"/>
                            <field name="accepted"/>
                            <field name="pdf_id"/>
                        </group>
                    </group>
                    <group invisible="accepted">
                        <field name="signature" widget="image" readonly="state == 'signed'"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_vendor_contract_search" model="ir.ui.view">
        <field name="name">leaders.vendor.contract.search</field>
        <field name="model">leaders.vendor.contract</field>
        <field name="arch" type="xml">
            <search>
                <field name="vendor_id"/>
                <field name="terms_id"/>
                <filter name="signed" string="Signed" domain="[('state', '=', 'signed')]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_vendor" string="Vendor" context="{'group_by': 'vendor_id'}"/>
                    <filter name="group_terms" string="Terms" context="{'group_by': 'terms_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_vendor_contract" model="ir.actions.act_window">
        <field name="name">Vendor Contracts</field>
        <field name="res_model">leaders.vendor.contract</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_vendor_contracts" name="Vendor Contracts" parent="menu_marketplace_operations"
              action="action_vendor_contract" sequence="70"/>
    <menuitem id="menu_vendor_terms" name="Vendor Terms" parent="menu_configuration"
              action="action_vendor_terms" sequence="40"/>
</odoo>
