<odoo>
    <!-- equipment listings sent from the storefront -->
    <record id="view_equipment_listing_list" model="ir.ui.view">
        <field name="name">leaders.equipment.listing.list</field>
        <field name="model">leaders.equipment.listing</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'new'" decoration-muted="state in ('done', 'rejected')">
                <field name="name"/>
                <field name="create_date" string="Received"/>
                <field name="contact_name"/>
                <field name="phone" widget="phone"/>
                <field name="intent"/>
                <field name="equipment_type"/>
                <field name="condition"/>
                <field name="quantity"/>
                <field name="state" widget="badge" decoration-info="state == 'new'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_equipment_listing_form" model="ir.ui.view">
        <field name="name">leaders.equipment.listing.form</field>
        <field name="model">leaders.equipment.listing</field>
        <field name="arch" type="xml">
            <form string="Equipment Listing">
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Customer">
                            <field name="contact_name"/>
                            <field name="phone" widget="phone"/>
                            <field name="user_id" readonly="1"/>
                            <field name="locale"/>
                        </group>
                        <group string="Equipment">
                            <field name="intent"/>
                            <field name="equipment_type"/>
                            <field name="condition"/>
                            <field name="quantity"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Description from the customer"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_equipment_listing_search" model="ir.ui.view">
        <field name="name">leaders.equipment.listing.search</field>
        <field name="model">leaders.equipment.listing</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="contact_name"/>
                <field name="phone"/>
                <field name="equipment_type"/>
                <filter name="open" string="Open" domain="[('state', 'in', ('new', 'contacted'))]"/>
                <filter name="sell" string="For sale" domain="[('intent', '=', 'sell')]"/>
                <filter name="rent" string="For rent" domain="[('intent', '=', 'rent')]"/>
            </search>
        </field>
    </record>

    <record id="action_equipment_listing" model="ir.actions.act_window">
        <field name="name">Equipment Listings</field>
        <field name="res_model">leaders.equipment.listing</field>
        <field name="view_mode">list,form</field>
        <field name="context">{"search_default_open": 1}</field>
    </record>

    <!-- site settings: one record, opened directly -->
    <record id="view_site_settings_form" model="ir.ui.view">
        <field name="name">leaders.site.settings.form</field>
        <field name="model">leaders.site.settings</field>
        <field name="arch" type="xml">
            <form string="Storefront Site Settings">
                <sheet>
                    <group>
                        <group string="Contact">
                            <field name="phone" placeholder="+201001234567"/>
                            <field name="whatsapp" placeholder="+201001234567"/>
                            <field name="email" widget="email"/>
                            <field name="address"/>
                        </group>
                        <group string="Company">
                            <field name="legal_name"/>
                            <field name="commercial_register"/>
                            <field name="app_store_url" widget="url"/>
                            <field name="google_play_url" widget="url"/>
                        </group>
                    </group>
                    <group string="Company film (landing page)">
                        <group>
                            <field name="story_video_kind"/>
                            <field name="story_video_url" invisible="not story_video_kind"/>
                        </group>
                        <group>
                            <field name="story_poster" widget="image" options="{'size': [240, 135]}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_site_settings" model="ir.actions.server">
        <field name="name">Storefront Site Settings</field>
        <field name="model_id" ref="model_leaders_site_settings"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
    </record>

    <!-- storefront text pages -->
    <record id="view_site_page_list" model="ir.ui.view">
        <field name="name">leaders.site.page.list</field>
        <field name="model">leaders.site.page</field>
        <field name="arch" type="xml">
            <list>
                <field name="slug"/>
                <field name="title"/>
                <field name="write_date" string="Last updated"/>
                <field name="published" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_site_page_form" model="ir.ui.view">
        <field name="name">leaders.site.page.form</field>
        <field name="model">leaders.site.page</field>
        <field name="arch" type="xml">
            <form string="Storefront Page">
                <sheet>
                    <div class="oe_title"><h1><field name="title" placeholder="e.g. Privacy policy"/></h1></div>
                    <group>
                        <field name="slug"/>
                        <field name="published" widget="boolean_toggle"/>
                    </group>
                    <field name="content"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_site_page" model="ir.actions.act_window">
        <field name="name">Storefront Pages</field>
        <field name="res_model">leaders.site.page</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- customer testimonials of the landing page -->
    <record id="view_testimonial_list" model="ir.ui.view">
        <field name="name">leaders.testimonial.list</field>
        <field name="model">leaders.testimonial</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="role"/>
                <field name="company"/>
                <field name="video_kind"/>
                <field name="permission"/>
                <field name="published" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_testimonial_form" model="ir.ui.view">
        <field name="name">leaders.testimonial.form</field>
        <field name="model">leaders.testimonial</field>
        <field name="arch" type="xml">
            <form string="Testimonial">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar" options="{'size': [96, 96]}"/>
                    <div class="oe_title"><h1><field name="name" placeholder="Customer name"/></h1></div>
                    <group>
                        <group>
                            <field name="role"/>
                            <field name="company"/>
                            <field name="quote" placeholder="At most 160 characters"/>
                        </group>
                        <group>
                            <field name="video_kind"/>
                            <field name="video_url" invisible="not video_kind"/>
                            <field name="permission"/>
                            <field name="published" widget="boolean_toggle" readonly="not permission"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_testimonial" model="ir.actions.act_window">
        <field name="name">Testimonials</field>
        <field name="res_model">leaders.testimonial</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_equipment_listings" name="Equipment Listings" parent="menu_marketplace_operations"
              action="action_equipment_listing" sequence="60"
              groups="leaders_marketplace.group_equipment_listing_sales,leaders_marketplace.group_marketplace_manager"/>
    <!-- partner and client logos of the home page strip (GET /partners) -->
    <record id="view_site_partner_list" model="ir.ui.view">
        <field name="name">leaders.site.partner.list</field>
        <field name="model">leaders.site.partner</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="logo" widget="image" options="{'size': [96, 43]}"/>
                <field name="name"/>
                <field name="website" widget="url" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_site_partner_form" model="ir.ui.view">
        <field name="name">leaders.site.partner.form</field>
        <field name="model">leaders.site.partner</field>
        <field name="arch" type="xml">
            <form string="Partner / Client">
                <sheet>
                    <widget name="web_ribbon" title="Hidden" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name" placeholder="Write the Arabic name, then the English one with the language button"/>
                        <field name="logo" widget="image" filename="logo_name" options="{'size': [240, 108]}"/>
                        <field name="logo_name" invisible="1"/>
                        <field name="website" widget="url" placeholder="https://"/>
                        <field name="active" string="Shown on the website" widget="boolean_toggle"/>
                    </group>
                    <div class="text-muted small">
                        Upload a horizontal logo on a transparent background, SVG or PNG, about 240x108 px or larger,
                        in its normal colours: the website shows every logo in one colour itself.
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_site_partner" model="ir.actions.act_window">
        <field name="name">Partners / Clients</field>
        <field name="res_model">leaders.site.partner</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <menuitem id="menu_storefront_content" name="Storefront" parent="menu_configuration" sequence="40"/>
    <menuitem id="menu_site_settings" name="Site Settings" parent="menu_storefront_content" action="action_site_settings" sequence="10"/>
    <menuitem id="menu_site_pages" name="Pages" parent="menu_storefront_content" action="action_site_page" sequence="20"/>
    <menuitem id="menu_testimonials" name="Testimonials" parent="menu_storefront_content" action="action_testimonial" sequence="30"/>
    <menuitem id="menu_site_partners" name="Partners / Clients" parent="menu_storefront_content" action="action_site_partner" sequence="40"/>
</odoo>
