<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_question_list" model="ir.ui.view">
        <field name="name">leaders.product.question.list</field>
        <field name="model">leaders.product.question</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'hidden'" decoration-warning="state == 'pending'">
                <field name="create_date"/>
                <field name="product_tmpl_id"/>
                <field name="partner_id"/>
                <field name="question"/>
                <field name="answered_partner_id"/>
                <field name="state" widget="badge" decoration-warning="state == 'pending'" decoration-success="state == 'answered'" decoration-muted="state == 'hidden'"/>
                <field name="approved" optional="show"/>
                <field name="is_public" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_product_question_form" model="ir.ui.view">
        <field name="name">leaders.product.question.form</field>
        <field name="model">leaders.product.question</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" string="Approve Answer" type="object" class="btn-primary"
                            invisible="state != 'answered' or approved"/>
                    <button name="action_hide" string="Hide" type="object" invisible="state == 'hidden'"
                            confirm="Hide this question from the product page?"/>
                    <button name="action_unhide" string="Show Again" type="object" invisible="state != 'hidden'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,answered,hidden"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="product_tmpl_id" readonly="1"/>
                            <field name="product_id" readonly="1" invisible="not product_id"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="create_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="is_public"/>
                            <field name="approved" readonly="1"/>
                            <field name="answered_partner_id" readonly="1"/>
                            <field name="answered_user_id" readonly="1"/>
                            <field name="answer_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Question"><field name="question" nolabel="1" readonly="1"/></group>
                    <group string="Answer"><field name="answer" nolabel="1" readonly="1"/></group>
                    <group string="Moderation">
                        <field name="hidden_reason" readonly="state == 'hidden'"/>
                        <field name="hidden_by" invisible="state != 'hidden'"/>
                        <field name="hidden_date" invisible="state != 'hidden'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_product_question_search" model="ir.ui.view">
        <field name="name">leaders.product.question.search</field>
        <field name="model">leaders.product.question</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_tmpl_id"/>
                <field name="partner_id"/>
                <field name="question"/>
                <field name="answer"/>
                <field name="answered_partner_id"/>
                <filter name="to_moderate" string="Questions to moderate" domain="[('state', '=', 'answered'), ('approved', '=', False)]"/>
                <filter name="pending" string="Not Answered" domain="[('state', '=', 'pending')]"/>
                <filter name="answered" string="Answered" domain="[('state', '=', 'answered')]"/>
                <filter name="hidden" string="Hidden" domain="[('state', '=', 'hidden')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_product" string="Product" context="{'group_by': 'product_tmpl_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_product_question" model="ir.actions.act_window">
        <field name="name">Product Questions</field>
        <field name="res_model">leaders.product.question</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_product_question_search"/>
    </record>
    <menuitem id="menu_product_questions" name="Product Questions" parent="menu_marketplace_operations" action="action_product_question" sequence="55" groups="leaders_marketplace.group_marketplace_reviewer"/>
</odoo>
