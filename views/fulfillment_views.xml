<odoo>
    <record id="view_fulfillment_inbound_tree" model="ir.ui.view">
        <field name="name">leaders.fulfillment.inbound.tree</field>
        <field name="model">leaders.fulfillment.inbound</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="location_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_fulfillment_inbound_form" model="ir.ui.view">
        <field name="name">leaders.fulfillment.inbound.form</field>
        <field name="model">leaders.fulfillment.inbound</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_receive" type="object" string="Receive" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('received', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,received"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="vendor_id"/>
                        <field name="location_id" readonly="1"/>
                        <field name="state" invisible="1"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="product_id" domain="[('is_storable', '=', True)]"/>
                            <field name="quantity"/>
                            <field name="uom_id" readonly="1"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_fulfillment_inbound" model="ir.actions.act_window">
        <field name="name">FBL Inbounds</field>
        <field name="res_model">leaders.fulfillment.inbound</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_fulfillment_fee" model="ir.actions.act_window">
        <field name="name">Fulfillment Fees</field>
        <field name="res_model">leaders.fulfillment.fee</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_fulfillment_policy" model="ir.actions.act_window">
        <field name="name">Fulfillment Policies</field>
        <field name="res_model">leaders.fulfillment.policy</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
