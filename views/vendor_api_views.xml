<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vendor_api_key_list" model="ir.ui.view">
        <field name="name">leaders.vendor.api.key.list</field>
        <field name="model">leaders.vendor.api.key</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-muted="is_revoked">
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="scope"/>
                <field name="key_prefix"/>
                <field name="create_date"/>
                <field name="last_used"/>
                <field name="revoked_date"/>
                <field name="is_revoked" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_vendor_api_key_form" model="ir.ui.view">
        <field name="name">leaders.vendor.api.key.form</field>
        <field name="model">leaders.vendor.api.key</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_revoke" type="object" string="Revoke" class="btn-danger"
                            invisible="is_revoked" confirm="Revoke this key? Calls using it stop working immediately."/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="vendor_id"/>
                            <field name="user_id"/>
                            <field name="scope"/>
                        </group>
                        <group>
                            <field name="key_prefix"/>
                            <field name="create_date"/>
                            <field name="last_used"/>
                            <field name="revoked_date"/>
                            <field name="is_revoked" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_vendor_api_key" model="ir.actions.act_window">
        <field name="name">Vendor API Keys</field>
        <field name="res_model">leaders.vendor.api.key</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_vendor_api_keys" name="Vendor API Keys" parent="menu_marketplace_operations" action="action_vendor_api_key" sequence="24" groups="leaders_marketplace.group_marketplace_manager"/>
</odoo>
