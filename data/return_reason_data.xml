<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Default return reasons; edit them under Marketplace > Configuration > Return Reasons. -->
    <record id="return_reason_damaged" model="leaders.return.reason">
        <field name="name">The product arrived damaged</field>
        <field name="sequence">10</field>
        <field name="requires_photo" eval="True"/>
    </record>
    <record id="return_reason_wrong_item" model="leaders.return.reason">
        <field name="name">I received the wrong item</field>
        <field name="sequence">20</field>
        <field name="requires_photo" eval="True"/>
    </record>
    <record id="return_reason_not_as_described" model="leaders.return.reason">
        <field name="name">Not as described</field>
        <field name="sequence">30</field>
    </record>
    <record id="return_reason_changed_mind" model="leaders.return.reason">
        <field name="name">I changed my mind</field>
        <field name="sequence">40</field>
        <field name="customer_pays_shipping" eval="True"/>
    </record>
    <record id="return_reason_no_longer_needed" model="leaders.return.reason">
        <field name="name">I no longer need it</field>
        <field name="sequence">50</field>
        <field name="customer_pays_shipping" eval="True"/>
    </record>
</odoo>
