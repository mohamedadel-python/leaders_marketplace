    <record id="mail_template_service_request_received" model="mail.template">
        <field name="name">Storefront: service request received</field>
        <field name="model_id" ref="leaders_marketplace.model_leaders_customer_request"/>
        <field name="subject">We received your request {{ object.name }}</field>
        <field name="email_from">{{ (object.env.company.email_formatted or user.email_formatted) }}</field>
        <field name="lang">{{ ctx.get('lang') }}</field>
        <field name="body_html" type="html">
